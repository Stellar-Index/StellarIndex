# Host reverse proxy (Debian KVM host, 95.217.126.13) for the test-net VMs.
# All 4 subdomains resolve to THIS host (DNS A→95.217.126.13, AAAA→::2);
# Caddy demuxes by Host header to the correct VM over the private NAT and
# auto-provisions Let's Encrypt certs (api.* are DNS-only/grey on Cloudflare,
# so HTTP-01 reaches here). flush_interval -1 disables buffering — REQUIRED
# for the API's Server-Sent-Events streams (live ledger + movements feeds).

api.testnet.stellarindex.io {
	reverse_proxy 192.168.122.10:3000 {
		flush_interval -1
	}
}

api.futurenet.stellarindex.io {
	reverse_proxy 192.168.122.20:3000 {
		flush_interval -1
	}
}

# Explorer subdomains (Phase 5 — the Next.js explorer, network-configured).
# Until the per-network explorer is deployed, point them at their API so the
# hostname resolves to something useful.
testnet.stellarindex.io {
	reverse_proxy 192.168.122.10:3000 {
		flush_interval -1
	}
}

futurenet.stellarindex.io {
