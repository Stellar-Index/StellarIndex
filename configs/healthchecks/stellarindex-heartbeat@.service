[Unit]
Description=Stellar Index Healthchecks.io heartbeat — %i
Documentation=https://github.com/Stellar-Index/StellarIndex/blob/main/configs/healthchecks/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# The timer re-fires every 60s (OnUnitActiveSec, see the .timer unit)
# and systemd will not start a new instance while this one is still
# running, so a hung heartbeat silently stops all future pings forever.
TimeoutStartSec=30s
RuntimeMaxSec=30s
ExecStart=/opt/stellarindex/healthchecks/heartbeat.sh %i
# systemd reads this as root before dropping to DynamicUser, so a
# 0600 secret stays unreadable to the unprivileged service user
# while still being passed through as environment variables.
EnvironmentFile=-/etc/default/stellarindex-healthchecks
DynamicUser=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# heartbeat.sh records whether its Healthchecks.io ping was actually
# delivered, in
# /var/lib/node_exporter/textfile_collector/hc_ping_<service>.prom.
# ProtectSystem=strict makes /var read-only; without ReadWritePaths the
# write fails with EROFS and a lost ping goes back to being invisible —
# the same grant the smoke and sla-probe units already carry. The
# archival-node role provisions the directory 0775 group stellarindex.
ReadWritePaths=/var/lib/node_exporter/textfile_collector
SupplementaryGroups=stellarindex
