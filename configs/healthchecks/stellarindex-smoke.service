[Unit]
Description=Stellar Index API smoke test (schema + data integrity)
Documentation=https://github.com/Stellar-Index/StellarIndex/blob/main/configs/healthchecks/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# The timer re-fires every 5 min (OnUnitActiveSec, see the .timer unit)
# and systemd will not start a new instance while this one is still
# running, so a hung smoke test silently stops all future runs forever.
# 2 min covers the 34-GET run with margin while still guaranteeing the
# unit is dead well before the next scheduled fire.
TimeoutStartSec=2min
RuntimeMaxSec=2min
ExecStart=/opt/stellarindex/healthchecks/smoke.sh
EnvironmentFile=-/etc/default/stellarindex-healthchecks
DynamicUser=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# smoke.sh writes /var/lib/node_exporter/textfile_collector/api_smoke.prom
# so stellarindex_api_smoke_{failing,stale} have real series to evaluate.
# ProtectSystem=strict makes /var read-only; without ReadWritePaths every
# run would fail with EROFS on the textfile and the alerts would see an
# absent series forever. Same grant the sla-probe unit already carries:
# the archival-node role provisions the directory 0775 group
# stellarindex, and DynamicUser joins that group to write there.
ReadWritePaths=/var/lib/node_exporter/textfile_collector
SupplementaryGroups=stellarindex
