{# Render-time — managed by ansible (patroni role). #}
{# After first run, amend via `patronictl edit-config` not by re-rendering. #}
scope: {{ patroni_cluster_name }}
namespace: /service/
name: {{ inventory_hostname }}

restapi:
  # Listen is the private/cluster interface (never 0.0.0.0)
  # and the authentication block is UNCONDITIONAL — 06-patroni-configure
  # asserts both credentials are non-empty before this template renders,
  # so the old "omit auth when vars are empty" silent-unauth path is gone.
  listen: {{ patroni_rest_listen }}
  connect_address: {{ patroni_rest_connect_address }}
  authentication:
    username: '{{ patroni_rest_basic_auth_user }}'
    password: '{{ patroni_rest_basic_auth_password }}'

etcd3:
{% if etcd_tls_enabled %}
  protocol: https
  cacert: {{ patroni_etcd_tls_dir }}/ca.pem
  cert: {{ patroni_etcd_tls_dir }}/client.pem
  key: {{ patroni_etcd_tls_dir }}/client-key.pem
{% endif %}
  hosts:
{% for host in groups['postgres_cluster'] %}
    - "{{ hostvars[host].ansible_host }}:{{ etcd_client_port }}"
{% endfor %}

{# Patroni initializes a cluster only when 'bootstrap' is in its config (ha.py), so
   only db-01 can ever run initdb; a replica with an empty DCS waits for a leader. #}
{% if inventory_hostname == groups['postgres_cluster'][0] %}
bootstrap:
  dcs:
    ttl: 30
    loop_wait: 10
    retry_timeout: 10
    maximum_lag_on_failover: 1048576
    synchronous_mode: {{ patroni_synchronous_mode | string | lower }}
    synchronous_node_count: {{ patroni_synchronous_node_count }}

    postgresql:
      use_pg_rewind: true
      parameters:
        wal_level: replica
        hot_standby: 'on'
        synchronous_commit: remote_apply
{# synchronous_standby_names is Patroni's to write (synchronous_mode); a
   hand-written list of unquoted db-0N names does not parse, and Postgres
   then refuses to start once synchronous_mode is off. #}
        max_connections: {{ patroni_postgres_max_connections }}
        max_replication_slots: 10
        max_wal_senders: 10
        wal_keep_size: '1024MB'
        archive_mode: 'on'
        archive_command: '{{ patroni_archive_command }}'
        # TimescaleDB extension preloading — required for the
        # extension to install on a fresh primary.
        shared_preload_libraries: 'timescaledb,pg_stat_statements'

  # Patroni appends bootstrap.pg_hba to initdb's file, whose default lines are
  # `trust`; peer/scram replace them (Patroni passes the superuser password via --pwfile).
  initdb:
    - encoding: UTF8
    - data-checksums
    - auth-local: peer
    - auth-host: scram-sha-256

  pg_hba:
{% for cidr in patroni_internal_cidrs %}
    - host  replication  replicator  {{ cidr }}  md5
    - host  all          all         {{ cidr }}  md5
{% endfor %}
{% endif %}

postgresql:
  listen: "{{ patroni_postgres_listen_addr }}:{{ patroni_postgres_port }}"
  connect_address: "{{ ansible_host }}:{{ patroni_postgres_port }}"
  data_dir: {{ patroni_data_dir }}
  bin_dir: /usr/lib/postgresql/{{ patroni_postgres_version }}/bin
  pgpass: /tmp/pgpass0
  authentication:
    replication:
      username: replicator
      password: '{{ patroni_replicator_password }}'
    superuser:
      username: postgres
      password: '{{ patroni_postgres_password }}'
  parameters:
    unix_socket_directories: '/var/run/postgresql'

tags:
  nofailover: false
  noloadbalance: false
  clonefrom: false

log:
  dir: /var/log/patroni
  level: INFO
