{# Render-time — managed by ansible (prometheus role). Don't edit. #}
{# Validated by `amtool check-config` before reload. #}
{#                                                                        #}
{# This template uses the page / ticket / informational severity         #}
{# vocabulary defined in docs/operations/severity-ladder.md — the same   #}
{# labels every rule in deploy/monitoring/rules/ + configs/prometheus/   #}
{# rules.r1/ emits. The receiver fanout mirrors the standalone           #}
{# configs/alertmanager/alertmanager.r1.yml so a host can be brought up  #}
{# from either path with consistent behaviour.                            #}
{#                                                                        #}
{# The Discord title/message templates are held in {% raw %} blocks and  #}
{# must stay BYTE-IDENTICAL to the ones in alertmanager.r1.yml: they are #}
{# the same Go templates, and a divergence means one apply path can hit  #}
{# a payload limit the other cannot. See that file's header for the      #}
{# 2026-09-07 outage those bounds exist to prevent, and the measured     #}
{# worst case. Raw blocks (rather than the {{ "{{" }} escaping used for  #}
{# the rest of the file) are what makes the two readable side by side.   #}
{#                                                                        #}
{# "MIRRORS" IS NOW ENFORCED, NOT ASSERTED (#501). That claim stood in    #}
{# this header as a comment for four months and was false for one of      #}
{# them: c0815d73e routed `severity: informational` to a new              #}
{# chat-informational receiver in alertmanager.r1.yml and did not touch   #}
{# this file, so an apply of the prometheus role would have silently      #}
{# reinstated the #485 bug — every informational alert matched, routed   #}
{# and delivered nowhere. Nothing in CI could see it, because nothing in #}
{# CI read both files.                                                    #}
{#                                                                        #}
{# scripts/ci/check-alertmanager-parity.sh now renders BOTH paths with    #}
{# identical inputs and fails on any structural difference. Change one    #}
{# file, change the other, in the same commit.                            #}

global:
  resolve_timeout: 5m

# ─── Routing tree ────────────────────────────────────────────────
#
# Default `chat-default` (rather than a more drastic "pagerduty-
# default") so unknown-severity alerts surface in chat without
# spurious paging. Per-severity matchers below route the standard
# ladder. Deadmansswitch is a separately-rooted heartbeat that
# never matches any other route.
route:
  receiver: chat-default
  group_by: [alertname, severity]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 12h

  routes:
    # Deadmansswitch — fires constantly while Prometheus +
    # Alertmanager are alive. Routed to Healthchecks.io; when the
    # heartbeat stops, Healthchecks pages us via a separately-
    # hosted channel, catching outages of Prometheus or
    # Alertmanager themselves.
    # See docs/operations/runbooks/deadmansswitch.md.
    - matchers: [alertname = "stellarindex_deadmansswitch"]
      receiver: deadmansswitch
      group_interval: 60s
      repeat_interval: 60s
      continue: false

    # Delivery failure — reported OUT OF BAND, on purpose.
    #
    # stellarindex_alertmanager_notifications_failing is the alert that
    # says "a receiver is being refused by the far end". Routed by
    # severity alone it is a ticket, so it lands in chat-default — i.e.
    # it is delivered through the very integration whose failure it is
    # reporting. During the 2026-09-07 Discord outage it fired for 11
    # hours into the dead channel and nobody saw it: the only signal of
    # a delivery failure travelled the failing path.
    #
    # `continue: true` — this route ADDS a transport, it does not take
    # one away. The alert still falls through to the severity routes
    # below and reaches chat exactly as before whenever chat works.
    - matchers: [alertname = "stellarindex_alertmanager_notifications_failing"]
      receiver: alert-delivery-failure
      group_interval: 5m
      repeat_interval: 1h
      continue: true

    # Page — SEV-1: customer-visible outage. Highest-urgency chat
    # channel + (when wired) PagerDuty.
    - matchers: [severity = "page"]
      receiver: chat-page
      continue: false

    # Ticket — actionable but not customer-urgent. Lower repeat
    # cadence so a long-running ticket doesn't spam the channel.
    - matchers: [severity = "ticket"]
      receiver: chat-default
      repeat_interval: 24h
      continue: false

    # Informational — a low-traffic Discord channel of its own, kept
    # separate from `alerts` so a routine notice (an oracle publishing
    # a ticker we do not map yet) can never bury a ticket in the same
    # feed. With alertmanager_discord_webhook_url_informational unset
    # the receiver renders as a stub, identical to the `silent` it
    # replaced, so an unset URL is a no-op rather than a config error.
    - matchers: [severity = "informational"]
      receiver: chat-informational
      continue: false

# ─── Inhibit rules ───────────────────────────────────────────────
#
# Suppress lower-severity variants on the same component when a page is
# already firing — prevents stacking when an incident escalates and
# both the ticket-tier baseline alert and the page-tier escalation
# fire simultaneously.
#
# `equal` is [component] ONLY — NOT [alertname, component]. The page and
# its paired lower-severity alert have DIFFERENT alertnames (the
# ticket-tier baseline and the page-tier escalation are separate rules),
# so requiring alertname equality made the inhibition never fire. Match
# on `component` alone so the page suppresses the ticket/informational
# variants for that component.
inhibit_rules:
  - source_matchers: [severity = "page"]
    target_matchers: [severity =~ "ticket|informational"]
    equal: [component]

# ─── Receivers ───────────────────────────────────────────────────
#
# Every chat receiver short-circuits to a no-op stub when its
# webhook URL is unset — alerts still accumulate in the Alertmanager
# UI but don't fan out. Operators can wire any subset.
receivers:
  # Deadmansswitch heartbeat — Healthchecks.io webhook.
  - name: deadmansswitch
{% if alertmanager_healthchecks_deadmansswitch_url %}
    webhook_configs:
      - url: {{ alertmanager_healthchecks_deadmansswitch_url }}
        send_resolved: false
{% else %}
    # No HEALTHCHECKS_DEADMANSSWITCH_URL — set
    # alertmanager_healthchecks_deadmansswitch_url in inventory
    # (or env-substitute at apply time). Without it the dead-man
    # heartbeat doesn't reach Healthchecks, defeating the
    # "Prometheus or Alertmanager itself is down" detection.
{% endif %}

  # Page-tier fanout — Discord #pages + (future) PagerDuty.
  - name: chat-page
{% if alertmanager_discord_webhook_url_pages %}
    discord_configs:
      - webhook_url: {{ alertmanager_discord_webhook_url_pages }}
        send_resolved: true{% raw %}
        title: '🚨 PAGE — {{ printf "%.120s" .GroupLabels.alertname }}'
        message: |
          {{ $max := 3 }}{{ $shown := .Alerts }}{{ if gt (len .Alerts) $max }}{{ $shown = slice .Alerts 0 $max }}{{ end }}{{ range $shown }}{{ $sum := printf "%.160s" .Annotations.summary }}{{ $desc := printf "%.300s" (trimSpace .Annotations.description) }}
          **{{ $sum }}{{ if ne $sum .Annotations.summary }} …{{ end }}**
          {{ $desc }}{{ if ne $desc (trimSpace .Annotations.description) }} …{{ end }}
          {{ if .Annotations.runbook_url }}Runbook: {{ printf "%.200s" .Annotations.runbook_url }}{{ end }}
          {{ end }}{{ if gt (len .Alerts) $max }}
          … and {{ len (slice .Alerts $max) }} more in this group — see {{ printf "%.120s" .ExternalURL }}
          {{ end }}
{% endraw %}
{% endif %}
{% if alertmanager_pagerduty_key %}
    pagerduty_configs:
      - service_key: {{ alertmanager_pagerduty_key }}
        send_resolved: true
{% endif %}
{% if not alertmanager_discord_webhook_url_pages and not alertmanager_pagerduty_key %}
    # No chat / pagerduty wiring on page-tier — alerts visible only
    # in Alertmanager UI. Set alertmanager_discord_webhook_url_pages
    # and/or alertmanager_pagerduty_key.
{% endif %}

  # Ticket-tier + default — Discord #alerts (no page-out).
  - name: chat-default
{% if alertmanager_discord_webhook_url_alerts %}
    discord_configs:
      - webhook_url: {{ alertmanager_discord_webhook_url_alerts }}
        send_resolved: true{% raw %}
        title: '{{ printf "%.120s" .GroupLabels.alertname }}'
        message: |
          {{ $max := 3 }}{{ $shown := .Alerts }}{{ if gt (len .Alerts) $max }}{{ $shown = slice .Alerts 0 $max }}{{ end }}{{ range $shown }}{{ $sum := printf "%.160s" .Annotations.summary }}{{ $desc := printf "%.300s" (trimSpace .Annotations.description) }}
          **[{{ printf "%.16s" (.Labels.severity | toUpper) }}]** {{ $sum }}{{ if ne $sum .Annotations.summary }} …{{ end }}
          {{ $desc }}{{ if ne $desc (trimSpace .Annotations.description) }} …{{ end }}
          {{ if .Annotations.runbook_url }}Runbook: {{ printf "%.200s" .Annotations.runbook_url }}{{ end }}
          {{ end }}{{ if gt (len .Alerts) $max }}
          … and {{ len (slice .Alerts $max) }} more in this group — see {{ printf "%.120s" .ExternalURL }}
          {{ end }}
{% endraw %}
{% else %}
    # No alertmanager_discord_webhook_url_alerts — ticket alerts
    # visible only in the Alertmanager UI. Set the webhook to fan out.
{% endif %}

  # Delivery-failure escape hatch — a SECOND Healthchecks.io check,
  # deliberately NOT the deadmansswitch one. Pinging the deadman check's
  # /fail endpoint would work mechanically, but it would make one signal
  # carry two meanings ("Prometheus or Alertmanager is dead" and "chat
  # delivery is being refused") and send the operator to the wrong
  # runbook. Provision a separate check — see
  # docs/operations/runbooks/alertmanager-notifications-failing.md.
  #
  # Dark until that check exists: with the variable unset this renders
  # as a stub. That is why the route above carries `continue: true` —
  # chat delivery is identical either way. max_alerts bounds the webhook
  # body for the same reason the Discord templates are bounded.
  - name: alert-delivery-failure
{% if alertmanager_healthchecks_alert_delivery_url %}
    webhook_configs:
      - url: {{ alertmanager_healthchecks_alert_delivery_url }}
        send_resolved: true
        max_alerts: 5
{% else %}
    # No alertmanager_healthchecks_alert_delivery_url — a Discord
    # outage will silence its own alarm again. Set
    # alertmanager_healthchecks_alert_delivery_url in inventory to a
    # Healthchecks check SEPARATE from the deadmansswitch one.
{% endif %}

  # Informational fanout → a dedicated Discord channel. Same bounded
  # template as chat-default: every interpolated field is capped and at
  # most $max alerts render, because an unbounded body is what returned
  # 400 for eleven hours and silently dropped every other alert with it.
  - name: chat-informational
{% if alertmanager_discord_webhook_url_informational %}
    discord_configs:
      - webhook_url: {{ alertmanager_discord_webhook_url_informational }}
        send_resolved: false{% raw %}
        title: '{{ printf "%.120s" .GroupLabels.alertname }}'
        message: |
          {{ $max := 3 }}{{ $shown := .Alerts }}{{ if gt (len .Alerts) $max }}{{ $shown = slice .Alerts 0 $max }}{{ end }}{{ range $shown }}{{ $sum := printf "%.160s" .Annotations.summary }}{{ $desc := printf "%.300s" (trimSpace .Annotations.description) }}
          **[FYI]** {{ $sum }}{{ if ne $sum .Annotations.summary }} …{{ end }}
          {{ $desc }}{{ if ne $desc (trimSpace .Annotations.description) }} …{{ end }}
          {{ if .Annotations.runbook_url }}Runbook: {{ printf "%.200s" .Annotations.runbook_url }}{{ end }}
          {{ end }}{{ if gt (len .Alerts) $max }}
          … and {{ len (slice .Alerts $max) }} more in this group — see {{ printf "%.120s" .ExternalURL }}
          {{ end }}
{% endraw %}
{% else %}
    # No alertmanager_discord_webhook_url_informational — informational
    # alerts are visible only in the Alertmanager UI. This is the same
    # black hole `silent` is, and it is why the variable exists: set it
    # to a channel of its own, NOT to the #alerts webhook.
{% endif %}

  # ─── silent — A BLACK HOLE, ON PURPOSE ─────────────────────────
  #
  # READ THIS BEFORE ASSUMING THE EMPTY STANZA IS AN OVERSIGHT.
  #
  # `- name: silent` has no webhook_configs, no discord_configs and
  # no pagerduty_configs, and that is DELIBERATE: an Alertmanager
  # receiver with no *_configs block accepts the alert and delivers
  # it to NOBODY.
  #
  # NOTHING ROUTES HERE TODAY (#485/#501, 2026-09-08). `severity:
  # informational` used to, which meant every informational alert was
  # matched, routed and delivered nowhere; they now go to chat-informational
  # above. The stanza is kept because it is the shape every receiver
  # degrades to when its URL is unset — an operator reading a rendered
  # config needs to recognise it — and removing it would make this
  # template diverge from configs/alertmanager/alertmanager.r1.yml,
  # which scripts/ci/check-alertmanager-parity.sh forbids.
  #
  # Do NOT route a severity here to quieten it. Whether a given
  # informational alert deserves delivery is a POLICY question, and
  # docs/operations/alerts-catalog.md's "Informational alerts —
  # delivery register" is where it is answered; the register is
  # enforced by scripts/ci/lint-alerts-catalog.py, so a new rule
  # cannot land in this bucket by accident.
  - name: silent
