{# Render-time — managed by ansible (haproxy role). Don't edit. #}

# A wedged haproxy faults this LB (weight 0). An empty api_pool only lowers
# priority: the peer probes the same pool, so a FAULT on both would drop the
# VIP. The weight must exceed the LBs' priority gap for a one-sided pool loss
# to move the VIP.
vrrp_script chk_haproxy_alive {
    script "/usr/local/bin/chk_haproxy.sh alive"
    interval 2
    fall 2
    rise 2
}

vrrp_script chk_api_pool {
    script "/usr/local/bin/chk_haproxy.sh pool"
    interval 2
    fall 2
    rise 2
    weight -50
}

vrrp_instance VI_API {
    # Both LBs start BACKUP and priority elects the MASTER: keepalived applies
    # preempt_delay only to a BACKUP-state instance, and the delay stops a
    # flapping pool probe from bouncing the VIP back on every recovery.
    state BACKUP
    preempt_delay {{ keepalived_preempt_delay | int }}
    interface {{ keepalived_iface }}
    virtual_router_id {{ keepalived_vrid }}
    priority {{ keepalived_priority }}
    advert_int 1

    # auth_pass is silently truncated past 8 bytes by keepalived;
    # vault-supplied; preflight warns if longer than 8 chars.
    authentication {
        auth_type PASS
        auth_pass {{ keepalived_vrrp_password }}
    }

{% if keepalived_unicast_src_ip and keepalived_unicast_peer_ips %}
    # Unicast VRRP — avoids relying on
    # multicast (224.0.0.18), which some cloud/VPC networks drop,
    # risking a dual-MASTER split brain on the shared VIP.
    unicast_src_ip {{ keepalived_unicast_src_ip }}
    unicast_peer {
{% for peer in keepalived_unicast_peer_ips %}
        {{ peer }}
{% endfor %}
    }
{% endif %}

    virtual_ipaddress {
        {{ haproxy_vip }}/{{ keepalived_vip_prefix_length }}
    }

    track_script {
        chk_haproxy_alive
        chk_api_pool
    }
}
