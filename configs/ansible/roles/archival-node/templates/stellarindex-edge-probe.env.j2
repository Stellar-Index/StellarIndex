# /etc/default/stellarindex-edge-probe-{{ item.name }} — rendered by Ansible (archival-node role,
# tag healthchecks). Do not edit by hand. Root 0600: EDGE_PROBE_PING_URL is the check's secret.
EDGE_PROBE_NAME={{ item.name }}
EDGE_PROBE_BASE_URL={{ item.base_url }}
EDGE_PROBE_CERT_MIN_DAYS={{ item.cert_min_days | default(edge_probe_cert_min_days) }}
{% if item.data_path is defined %}
EDGE_PROBE_DATA_PATH={{ item.data_path }}
{% endif %}
EDGE_PROBE_PING_URL={{ lookup('vars', item.ping_url_var) }}
