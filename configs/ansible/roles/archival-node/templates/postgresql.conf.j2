#
# postgresql.conf — tuned for stellar-core BucketListDB workload.
# See docs/architecture/infrastructure/archival-node-spec.md §3.2.
#

data_directory            = '/var/lib/postgresql/{{ postgres_version }}/main'
hba_file                  = '/etc/postgresql/{{ postgres_version }}/main/pg_hba.conf'
ident_file                = '/etc/postgresql/{{ postgres_version }}/main/pg_ident.conf'
external_pid_file         = '/var/run/postgresql/{{ postgres_version }}-main.pid'

listen_addresses          = '{{ postgres_listen_addresses }}'
port                      = {{ postgres_port }}
max_connections           = {{ postgres_max_connections }}
unix_socket_directories   = '/var/run/postgresql'

# Per-tx lock table sizing. Postgres sizes its lock table as
# `max_locks_per_transaction × max_connections`. TimescaleDB's
# chunk-based storage takes one shared-memory lock per chunk a
# query touches — not just INSERTs: any broad SELECT over a
# many-chunk hypertable (per-source coverage, pools/markets CTE,
# cagg/fx coverage) locks one entry per scanned chunk. Under
# concurrent load this saturates the table; writes/reads fail
# with SQLSTATE 53200 ("out of shared memory"). Two incidents:
#   - 2026-05-06 SEV-3 (default 64): ~1% of trades dropped, bumped
#     to 256 by hand
#     (`internal/incidents/data/2026-05-06-postgres-lock-table-full.md`).
#   - 2026-05-15 (256): trades grew to ~2,738 chunks; the all-time
#     SDEX backfill + concurrent diagnostic queries thrashed the
#     table again (single query observed holding 26,927 locks).
#     Re-sized to 4096 with permanent growth headroom — see the
#     long-form rationale on postgres_max_locks_per_transaction in
#     the role's defaults/main.yml.
# Codified here so a from-scratch R1 rebuild or R2/R3 cutover
# inherits the sizing automatically.
max_locks_per_transaction = {{ postgres_max_locks_per_transaction | default(4096) }}

# ─── Memory (~25% shared_buffers, ~50% effective_cache_size) ────────
shared_buffers            = {{ postgres_shared_buffers }}
effective_cache_size      = {{ postgres_effective_cache_size }}
work_mem                  = {{ postgres_work_mem }}
maintenance_work_mem      = {{ postgres_maintenance_work_mem }}

# ─── WAL ────────────────────────────────────────────────────────────
wal_level                 = replica
max_wal_senders           = 10
max_replication_slots     = 10
wal_compression           = {{ postgres_wal_compression }}
synchronous_commit        = on
checkpoint_timeout        = 15min
checkpoint_completion_target = 0.9
# WAL sizing. The 2GB this replaced was never chosen against this
# workload: the 2026-07-03 drift audit found 8GB sitting inert in the
# file while postgresql.auto.conf overrode it to 2GB, and codified the
# EFFECTIVE value. That fixed the drift and inherited the number.
#
# MEASURED 2026-09-15, 71 days of pg_stat_bgwriter: 14,282 REQUESTED
# checkpoints against 2,630 timed — 84.4% of checkpoints fired because
# WAL hit max_wal_size, not because checkpoint_timeout elapsed. That is
# one checkpoint every ~6 minutes against a 15-minute timeout, and with
# full_page_writes on, every checkpoint restarts full-page-image
# amplification: the first write to each 8KB page afterwards writes the
# whole page to WAL.
#
# The cost shows up in the archive bill. A single TimescaleDB
# decompress_chunk on `trades` rewrites a 1.5GB chunk and emits 12.7GB
# of WAL — roughly 8x the data, which is the FPI multiplier. At 2GB,
# one such decompression forces several checkpoints on its own.
#
# 16GB was set on that reasoning on 2026-09-15 and TOOK THE DATABASE
# DOWN ten hours later. It is reverted here, and the sentence that did
# the damage is worth quoting because the arithmetic around it was all
# correct:
#
#   "The disk cost is nothing — pg_wal sits on a dataset with 2.7TB
#    free."
#
# It does not. `/var/lib/postgresql/15/main/pg_wal` is a SYMLINK to
# /pgwal/15-main/pg_wal, and /pgwal is on the 49GB ROOT filesystem.
# The 2.7TB dataset holds the DATA directory; the WAL was never on it.
# The claim was inferred from where the data lives and never checked
# with `df` against the path WAL is actually written to.
#
# What followed, on 2026-09-16 at 05:15 CEST: pg_wal grew from ~2GB to
# 9.8GB, root reached 0 bytes available, Postgres crashed, and crash
# recovery then could not complete —
#
#   redo done at 240F/2EFFFFA0
#   FATAL: could not write to file "pg_wal/xlogtemp.3049031":
#          No space left on device
#
# — so it shut down rather than come up inconsistent, which is correct
# behaviour and the only reason this was an outage rather than damage.
# Eighteen units failed behind it and the API served 503 for ~3 hours.
# Nothing was lost: archiving was fully caught up (0 `.ready` files) and
# the newest off-site backup was 5h old. Reverting this value to 2GB
# returned 7.7GB of root within minutes of the restart, which is the
# clearest confirmation of the cause available.
#
# The checkpoint measurement above still stands and the problem it
# describes is real. The fix is NOT a bigger number on this line while
# WAL lives on a 49GB volume shared with the OS. It is to move pg_wal
# onto the pool that already has the room, and only then re-tune this —
# at which point the original reasoning becomes true rather than
# aspirational. Until that move lands, `postgres_wal_headroom_assert`
# (roles/archival-node/tasks) refuses an apply whose max_wal_size does
# not fit the filesystem pg_wal really sits on.
#
# max_wal_size is SIGHUP, so this applies on reload and needs no
# restart — which is also why a bad value reaches production without a
# restart to think twice about.
max_wal_size              = {{ postgres_max_wal_size | default('2GB') }}
min_wal_size              = {{ postgres_min_wal_size | default('2GB') }}

# ─── Planner ────────────────────────────────────────────────────────
random_page_cost          = 1.1     # NVMe
effective_io_concurrency  = 200
default_statistics_target = 100

# ─── Logging ────────────────────────────────────────────────────────
log_destination           = 'stderr'
logging_collector         = on
log_directory             = '/var/log/postgresql'
log_filename              = 'postgresql-{{ postgres_version }}-main.log'
log_min_duration_statement = 1000
log_checkpoints           = on
log_connections           = on
log_disconnections        = on
log_lock_waits            = on
log_timezone              = 'UTC'

# ─── Locale / timezone ──────────────────────────────────────────────
datestyle                 = 'iso, mdy'
timezone                  = 'UTC'
lc_messages               = 'en_US.UTF-8'
lc_monetary               = 'en_US.UTF-8'
lc_numeric                = 'en_US.UTF-8'
lc_time                   = 'en_US.UTF-8'
default_text_search_config = 'pg_catalog.english'

# ─── Stats ──────────────────────────────────────────────────────────
# `timescaledb` MUST be preloaded — the trades/oracle_updates
# hypertables, continuous aggregates and Timescale background jobs
# all depend on the extension being available at startup. Matches
# r1's live config; a rebuild without it breaks every CAGG.
shared_preload_libraries  = 'timescaledb,pg_stat_statements'

# ─── Background workers ─────────────────────────────────────────────
# These three are a SET, and the relationship between them is the
# whole point of pinning them here.
#
# TimescaleDB defaults timescaledb.max_background_workers to 16;
# PostgreSQL defaults max_worker_processes to 8. Left untuned — which
# is what r1 was, both reading `source = default` in pg_settings —
# Timescale is licensed to run twice as many background workers as
# Postgres has worker slots, and those slots are shared with parallel
# query workers on top. The scheduler then loses the race for a slot
# and the job dies with "failed to start job".
#
# This was not theoretical on r1: across 46 scheduled jobs (23
# compression policies, 20 continuous-aggregate refresh policies, 3
# retention/telemetry) EVERY refresh policy was failing 37–69% of its
# runs, ~134k failures on the busiest. It stayed invisible because the
# jobs did eventually get a slot on a later tick, so `last_run_status`
# read Success and the caggs were never actually stale — and because
# the alert that would have caught staleness has no producer and is
# INERT (see deploy/monitoring/rules/storage.yml).
#
# Sizing, per Timescale's documented rule
# (max_worker_processes >= timescaledb.max_background_workers +
#  max_parallel_workers + a few spare for the launcher/extensions):
#
#     16 (timescale bg) + 8 (parallel) + 8 spare = 32
#
# max_parallel_workers and max_parallel_workers_per_gather are
# deliberately LEFT AT THEIR DEFAULTS (8 / 2). Raising them changes
# query plans across the whole API read path, which is a separate
# decision with its own latency risk; this change is scoped to
# stopping the scheduler from starving. Unused worker slots cost only
# a little shared memory, so 32 is cheap headroom rather than a
# commitment to run 32 workers.
#
# NOTE: max_worker_processes is postmaster-level — it needs a Postgres
# RESTART, not a reload. Until that restart it stays at 8 and the job
# failures continue.
max_worker_processes      = 32
timescaledb.max_background_workers = 16
