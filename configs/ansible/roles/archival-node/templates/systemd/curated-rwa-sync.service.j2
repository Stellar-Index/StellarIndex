# systemd unit: third-party curated RWA directory sync.
#
# Rendered by Ansible. Caches a named third party's curated list of
# tokenized real-world assets on Stellar — first curator: the Stellar
# team's public Dune uploads — into rwa_curated_directory (migration
# 0161) for the RWA surface's curated arm. One Dune SQL execution per
# run on the "medium" tier (the only tier below "large" that Dune names;
# "small" is refused with HTTP 400 before the SQL runs), then a status
# poll every 2s until it finishes, then the result paged 1,000 rows at a
# time, at most 5,000 rows. The credit cost Dune reports for the
# execution is emitted as a gauge, so the price of this arm is a metric.
#
# WHAT IT CACHES, and what that is worth: the curator's word. A row is a
# name, an address and a figure that a third party chose to publish; no
# signature, no proof of control, no market. The surface serves it under
# `basis: third_party_curated` with its own total, beside the verified
# set and never inside it, and the reader refuses any row whose
# synced_at is older than 48 hours — a sync that stops leaves an
# absence, not a stale price.
#
# THE API KEY. Read from DUNE_API_KEY in /etc/default/curated-rwa-sync
# (root:root, mode 0600). Only systemd reads that file, as PID 1 before
# it drops to User=stellarindex, so unlike /etc/default/stellarindex it
# needs no group read. The archival-node role renders it from
# `vault_dune_api_key` when the vault defines that, and otherwise
# installs an empty `DUNE_API_KEY=` placeholder once (never overwriting
# a key an operator pasted in). Without a key the run REFUSES rather
# than pretending it read the curator: it exits clean, still stamps the
# textfile, and sets the `refused` gauge that
# stellarindex_curated_rwa_sync_refused alerts on.
#
# /etc/default/stellarindex is loaded too, for the Postgres DSN the
# on-disk stellarindex.toml deliberately omits.
[Unit]
Description=Stellar Index — third-party curated RWA directory sync (daily)
Documentation=https://github.com/Stellar-Index/StellarIndex/blob/main/migrations/0161_create_rwa_curated_directory.up.sql
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=-/etc/default/curated-rwa-sync
EnvironmentFile=-/etc/default/stellarindex

# Defaults. Operators override via /etc/default/curated-rwa-sync.
#
# RUN_TIMEOUT sizing: the run is bounded not by transfer size (the
# result is under a hundred rows) but by Dune's engine — the execution
# queues behind other tenants and the poll loop waits for it, with each
# HTTP call individually capped at 90s in the code. 6m is above the
# binary's own 5m default so the wall clock is visible here, and it is
# finite because a hung execution against a third party is a hang, not
# a slow success. A run that hits it exits non-zero WITHOUT stamping
# the textfile, so repeated timeouts surface as
# stellarindex_curated_rwa_sync_stale. TimeoutStartSec below sits above
# it so the binary's own deadline, not systemd's SIGTERM, ends the run.
Environment=CONFIG_PATH=/etc/stellarindex.toml
Environment=RUN_TIMEOUT=6m
Environment=EXTRA_FLAGS=

ExecStart=/usr/local/bin/stellarindex-ops curated-rwa-sync \
  -config ${CONFIG_PATH} \
  -timeout ${RUN_TIMEOUT} \
  -write \
  -textfile /var/lib/node_exporter/textfile_collector/curated_rwa_sync.prom \
  ${EXTRA_FLAGS}

# De-privileged, same shape as directory-sync and sep1-refresh
# (CS-118/CS-119): reads config, talks HTTPS to one third party, writes
# Postgres.
User=stellarindex
Group=stellarindex

ProtectSystem=strict
# The run writes its credit cost and row counts to the textfile collector;
# ProtectSystem=strict makes /var read-only without this grant.
ReadWritePaths=/var/lib/node_exporter/textfile_collector
PrivateTmp=true
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

TimeoutStartSec=8min

# Memory ceiling — the input is a third-party JSON body. The code caps
# each response read at 32 MB and pages the result 1,000 rows at a time
# with a 5,000-row ceiling on the whole sync (the curator's list is under
# a hundred rows; anything past the ceiling is not that list), but that
# is the code's own guard; this is the host-level backstop so a surprise
# can never compete with galexie's captive core, Postgres and ClickHouse
# on this single box — the 2026-07-05 wedge class. MemorySwapMax=0 kills
# rather than swaps.
MemoryMax=1G
MemorySwapMax=0

[Install]
WantedBy=multi-user.target
