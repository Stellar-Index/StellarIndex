# systemd unit: asset-holders rollup recompute (inventory #4).
#
# Rendered by Ansible. Recomputes every asset's holders board and holder
# count plus the accounts analytics into staging tables, checks them
# against the live tables (shrink guard), then EXCHANGEs them live in one
# atomic swap (deploy/clickhouse/asset_holders_rollup.sql). Every run is
# a full recompute — there is no watermark and no backfill. The companion
# timer re-runs it 30 minutes after each run ends.

[Unit]
Description=Stellar Index — asset-holders rollup recompute
Documentation=https://github.com/Stellar-Index/StellarIndex/blob/main/docs/operations/open-fixes-inventory-2026-08-08.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=-/etc/default/holders-rollup
EnvironmentFile=-/etc/default/stellarindex
EnvironmentFile=-/etc/default/stellarindex-ops

Environment=CH_ADDR=127.0.0.1:9300
Environment=EXTRA_FLAGS=

ExecStart=/usr/local/bin/stellarindex-ops ch-holders-rollup \
  -ch-addr ${CH_ADDR} \
  -write \
  $EXTRA_FLAGS

# De-privileged, same shape as the sibling oneshots (CS-118/CS-119).
User=stellarindex
Group=stellarindex

ProtectSystem=strict
PrivateTmp=true
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
# T572: ch-holders-rollup now takes an exclusive flock on
# /var/lib/stellarindex/ch-holders-rollup.lock before it runs, so a
# manually-invoked run cannot overlap this timer. ProtectSystem=strict
# makes the whole filesystem read-only except what is listed here —
# PrivateTmp is per-unit-instance and would NOT be visible to a
# manually-invoked process outside systemd, so the lock has to live on
# the shared, already stellarindex-owned data dir, not under /tmp.
ReadWritePaths=/var/lib/stellarindex

# The cycle runs its statements serially and seven of them cap
# themselves at max_execution_time=600, so ClickHouse allows a cycle up
# to 70 min. The unit ceiling sits above that sum so systemd never kills
# a cycle ClickHouse would still let finish (a killed run publishes
# nothing), while still releasing a wedged slot. Raise it with the caps.
TimeoutStartSec=80min

# Memory ceiling — the rollup's window functions spill externally at
# 4GB (SETTINGS in the job SQL); this is the host-level backstop
# (the 2026-07-05 wedge class). Swap-kill, not swap-crawl.
MemoryMax=4G
MemorySwapMax=0
# Batch-class weights: this must never starve galexie's captive core.
CPUWeight=25
IOWeight=25

[Install]
WantedBy=multi-user.target

