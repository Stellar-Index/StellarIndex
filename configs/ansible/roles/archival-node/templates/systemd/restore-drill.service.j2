# systemd unit: pgBackRest restore-drill (ADR-0043).
#
# Rendered by Ansible. Runs scripts/ops/restore-drill.sh — a
# NON-DESTRUCTIVE scratch restore of the pgBackRest stanza into a
# disposable Postgres, proving the backup chain is actually
# restorable rather than just "present" (a backup nobody has ever
# restored is a hope, not a backup). Results append to the
# drill evidence log the script maintains.
#
# Enabling is an operator call: this unit is installed but NOT enabled
# by the ansible role (see 18-pgbackrest-backup.yml). The drill needs
# MIN_FREE_GB=200 free on the drill volume and the script refuses to
# run below that (safe-by-construction), but starting a heavy recurring
# job on a capacity-tight pool is a decision, not a default. Enable with:
#   systemctl enable --now restore-drill.timer

[Unit]
Description=Stellar Index — pgBackRest restore-drill (ADR-0043 / CS-110)
Documentation=https://github.com/Stellar-Index/StellarIndex/blob/main/docs/adr/0043-backup-and-restore-strategy.md
After=postgresql.service network-online.target
Wants=postgresql.service

# Restart-storm limit — matches the stellarindex-*.service.j2 pattern
# (systemd >=230 ignores StartLimit* under [Service]).
StartLimitIntervalSec=1h
StartLimitBurst=3

[Service]
Type=oneshot
EnvironmentFile=-/etc/default/stellarindex-ops
# ADR-0043 §2.2 says the drill re-derives a random 100k-ledger window
# from the archive and MEASURES throughput, "giving an honest RTO
# figure". Without this set the CH stage never runs on the schedule
# and the lake RTO is an unmeasured claim. Dry-run (decode only,
# nothing written); the script emits the throughput gauges to the
# node_exporter textfile dir when this is set.
Environment=DRILL_CH_WINDOW=100000
# 75 = run-heavy-job.sh skipped this fire (lock held): not a failure.
SuccessExitStatus=75
# Queue behind another heavy job (host-wide and scheduled locks) for up to
# 12h instead of skipping the fire; TimeoutStartSec below covers wait + run.
Environment=HEAVY_JOB_LOCK_WAIT=43200
Environment=HEAVY_JOB_CLASS=scheduled
# A stop must let the script's EXIT trap shut down the scratch Postgres and
# remove its data dir before SIGKILL.
Environment=HEAVY_JOB_STOP_TIMEOUT=15min
ExecStart=/usr/local/sbin/run-heavy-job.sh restore-drill /usr/local/bin/restore-drill.sh
# The script itself requires root (drops to postgres via sudo -u for
# the actual pg/pgbackrest operations) — see its own EUID check.
User=root

# The drill's deliverable is DR EVIDENCE, and journald rotates.
# Persist the run log off journald as belt-and-suspenders alongside the
# script's own durable evidence file (RESTORE_DRILL_LOG_DIR, default
# /var/lib/stellarindex/restore-drills) and its node_exporter metric.
StandardOutput=append:/var/log/restore-drill.log
StandardError=append:/var/log/restore-drill.log

# Keep drill I/O off the critical path of live ingest.
Nice=15
IOSchedulingClass=best-effort
IOSchedulingPriority=7

# WAL replay from the last backup can legitimately take a couple
# hours on a busy ingest DB (script's own PG_START_TIMEOUT default);
# cap generously above that so a genuinely wedged drill still fails
# and frees the next tick instead of running forever.
# Whole seconds: the 43200 s lock wait + 4h for the run itself.
TimeoutStartSec=57600

# Hardening — ProtectSystem=full (not strict): /usr, /boot and /etc are
# read-only but /var stays WRITABLE, so with no extra ReadWritePaths the
# script can still write its disposable Postgres data dir under DRILL_ROOT
# (default /var/tmp/restore-drill), its durable evidence log under
# /var/lib/stellarindex/restore-drills (RESTORE_DRILL_LOG_DIR — created at
# runtime via mkdir -p), its node_exporter metric under
# /var/lib/node_exporter/textfile_collector, and its run log to
# /var/log/restore-drill.log. ReadWritePaths is intentionally NOT
# extended for these: they may not pre-exist, and a missing path in
# ReadWritePaths fails namespace setup before ExecStart — full already
# grants them.
#
# There is NO ReadWritePaths at all. /var/tmp/restore-drill can NEVER
# resolve here — PrivateTmp=true (below) gives this unit its own empty
# /tmp and /var/tmp, so a drill dataset there is invisible inside the
# namespace and systemd fails the unit at namespace setup
# (226/NAMESPACE) before ExecStart on every scheduled fire (on r1 the
# drill never once ran on its timer that way; manual runs, which have
# no namespace, hid it). The dataset lives at
# /var/lib/stellarindex/restore-drill (defaults/main.yml), which
# ProtectSystem=full leaves writable and PrivateTmp does not shadow.
# NoNewPrivileges is deliberately NOT set. This unit runs as root by
# design and DROPS privilege with `sudo -u postgres` for every pg
# operation. no-new-privs blocks sudo's setuid transition, so the drill
# dies instantly with "unable to open /etc/sudoers: Operation not
# permitted". It also buys almost nothing here: a process already
# running as root has nothing left to escalate to, so the directive is
# pure downside — it disables the one mechanism the script uses to run
# with LESS privilege.
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
