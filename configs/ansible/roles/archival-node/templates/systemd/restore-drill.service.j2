# systemd unit: pgBackRest restore-drill (ADR-0043 / CS-110).
#
# Rendered by Ansible. Runs scripts/ops/restore-drill.sh — a
# NON-DESTRUCTIVE scratch restore of the pgBackRest stanza into a
# disposable Postgres, proving the backup chain is actually
# restorable rather than just "present" (a backup nobody has ever
# restored is a hope, not a backup — CS-110). Results append to the
# drill evidence log the script maintains.
#
# Sequencing (audit-2026-07-23 REL-backup-restore): this unit is
# installed but NOT enabled by the ansible role — see
# 18-pgbackrest-backup.yml. R1 was mid Phase-A capacity relief
# (ZFS pool ~94% full) when this landed; the drill needs
# MIN_FREE_GB=200 free on the drill volume and the script itself
# refuses to run below that (safe-by-construction), but starting a
# NEW heavy recurring job while capacity is this tight is an operator
# call, not a default. Enable once Phase A clears:
#   systemctl enable --now restore-drill.timer

[Unit]
Description=Stellar Index — pgBackRest restore-drill (ADR-0043 / CS-110)
Documentation=https://github.com/Stellar-Index/StellarIndex/blob/main/docs/adr/0043-backup-and-restore-strategy.md
After=postgresql.service network-online.target
Wants=postgresql.service

# Restart-storm limit — matches the stellarindex-*.service.j2 pattern
# (systemd >=230 ignores StartLimit* under [Service]).
StartLimitIntervalSec=1h
StartLimitBurst=3

[Service]
Type=oneshot
EnvironmentFile=-/etc/default/stellarindex-ops
# #343 (2026-09-02): ADR-0043 §2.2 says the drill re-derives a random 100k-
# ledger window from the archive and MEASURES throughput, "giving an honest
# RTO figure". The unit never set this, so the CH stage had never once run on
# the schedule and the lake RTO was an unmeasured claim. Dry-run (decode
# only, nothing written); the script emits the throughput gauges to the
# node_exporter textfile dir when this is set.
Environment=DRILL_CH_WINDOW=100000
ExecStart=/usr/local/bin/restore-drill.sh
# The script itself requires root (drops to postgres via sudo -u for
# the actual pg/pgbackrest operations) — see its own EUID check.
User=root

# BDR-03: the drill's deliverable is DR EVIDENCE, and journald rotates.
# Persist the run log off journald as belt-and-suspenders alongside the
# script's own durable evidence file (RESTORE_DRILL_LOG_DIR, default
# /var/lib/stellarindex/restore-drills) and its node_exporter metric.
StandardOutput=append:/var/log/restore-drill.log
StandardError=append:/var/log/restore-drill.log

# Keep drill I/O off the critical path of live ingest.
Nice=15
IOSchedulingClass=best-effort
IOSchedulingPriority=7

# WAL replay from the last backup can legitimately take a couple
# hours on a busy ingest DB (script's own PG_START_TIMEOUT default);
# cap generously above that so a genuinely wedged drill still fails
# and frees the next tick instead of running forever.
TimeoutStartSec=4h
RuntimeMaxSec=4h

# Hardening — ProtectSystem=full (not strict): /usr, /boot and /etc are
# read-only but /var stays WRITABLE, so with no extra ReadWritePaths the
# script can still write its disposable Postgres data dir under DRILL_ROOT
# (default /var/tmp/restore-drill), its durable evidence log under
# /var/lib/stellarindex/restore-drills (RESTORE_DRILL_LOG_DIR — created at
# runtime via mkdir -p), its node_exporter metric under
# /var/lib/node_exporter/textfile_collector, and its run log to
# /var/log/restore-drill.log (BDR-03). ReadWritePaths is intentionally NOT
# extended for these: they may not pre-exist, and a missing path in
# ReadWritePaths fails namespace setup before ExecStart — full already
# grants them.
#
# BDR-04 (2026-08-19): there is now NO ReadWritePaths at all. The single
# remaining entry was /var/tmp/restore-drill, and that path can NEVER
# resolve here — PrivateTmp=true (below) gives this unit its own empty
# /tmp and /var/tmp, so the host's ZFS drill dataset is invisible inside
# the namespace. systemd therefore failed the unit at namespace setup
# (226/NAMESPACE) before ExecStart on every scheduled fire, which is why
# the drill had never once run on its timer: the only passing evidence on
# record came from manual runs, which have no namespace. The dataset moved
# to /var/lib/stellarindex/restore-drill (defaults/main.yml), which
# ProtectSystem=full leaves writable and PrivateTmp does not shadow — so
# the directive that broke it is not needed at all.
# NoNewPrivileges is deliberately NOT set (BDR-04, 2026-08-19). This unit
# runs as root by design and DROPS privilege with `sudo -u postgres` for
# every pg operation. no-new-privs blocks sudo's setuid transition, so the
# drill died instantly with "unable to open /etc/sudoers: Operation not
# permitted" — the second namespace-class blocker found the same evening.
# It also buys almost nothing here: a process already running as root has
# nothing left to escalate to, so the directive was pure downside — it
# disabled the one mechanism the script uses to run with LESS privilege.
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
