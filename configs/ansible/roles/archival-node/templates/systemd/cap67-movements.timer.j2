# systemd timer: cap67 movements derive — follows the tip every ~30s.
#
# Rendered by Ansible. Companion to cap67-movements.service. The derive
# resumes from its watermark and exits when caught up; a steady-state
# fire is a ~0s incremental catch-up (measured 0s / ~50 ledgers on r1),
# so a tight cadence is nearly free. This is the classic-asset movement
# freshness on /accounts/{g}/movements — a blockchain explorer must show
# a user's transactions land promptly, so we follow the tip at ~30s
# rather than the old 5-minute lag. (For true up-to-the-second, the
# derive would run as a continuous follow-worker; the timer keeps it a
# simple, crash-safe one-shot.) AccuracySec is required — the systemd
# default (1min) would coalesce sub-minute fires away.

[Unit]
Description=cap67 account-movements derive (follows the lake tip, ~30s)
Documentation=https://github.com/Stellar-Index/StellarIndex/blob/main/docs/operations/open-fixes-inventory-2026-08-08.md

[Timer]
OnBootSec=30s
OnUnitInactiveSec=30s
AccuracySec=5s
RandomizedDelaySec=5
Persistent=true
Unit=cap67-movements.service

[Install]
WantedBy=timers.target
