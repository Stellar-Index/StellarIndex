# systemd unit: off-site mirror of the Galexie archive (off-site-backup-plan.md §1, NS03).
#
# Rendered by Ansible. Runs scripts/ops/galexie-archive-mirror.sh — `mc
# mirror` of the local galexie-archive bucket to the `{{ galexie_archive_mirror_dest_alias | default('r2-archive') }}`
# alias, verified with a post-mirror `mc mirror --dry-run`. With no
# DEST_ENDPOINT configured the run reports configured=0 and exits 1, so the
# unit shows failed and stellarindex_galexie_archive_mirror_stale tickets
# the host.

[Unit]
Description=Stellar Index — Galexie archive off-site mirror (off-site-backup-plan.md §1)
Documentation=https://github.com/Stellar-Index/StellarIndex/blob/main/docs/operations/off-site-backup-plan.md
After=minio.service network-online.target
Wants=minio.service

StartLimitIntervalSec=1h
StartLimitBurst=3

[Service]
Type=oneshot
EnvironmentFile=/etc/default/galexie-archive-mirror
ExecStart=/usr/local/bin/galexie-archive-mirror.sh
User=root

Nice=15
IOSchedulingClass=best-effort
IOSchedulingPriority=7

# The archive is multi-TiB; a first full sync can run for hours.
# Incrementals after that are minutes.
TimeoutStartSec=1d

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=/var/lib/node_exporter/textfile_collector /root/.mc

[Install]
WantedBy=multi-user.target
