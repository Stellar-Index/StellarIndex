# systemd timer: monthly OFF-SITE pgBackRest restore-drill, repo2 (ADR-0043).
#
# Rendered by Ansible; enabled where a repo2 bucket is configured
# (restore_drill_offsite_enabled in defaults/main.yml).
#
# Cadence: MONTHLY, the same commitment ADR-0043 §1/§3 makes for the
# on-box drill — each run pulls ~269 GB from S3 (~$24 of egress at the
# measured size) and holds the drill volume for ~1 h, so monthly is the
# heaviest cadence worth paying for and the lightest that keeps the proof
# current.
#
# Time slot: the 15TH of the month, 04:00 UTC + up to 30 min jitter. A
# fixed day rather than "third Saturday" because the staleness ticket
# (stellarindex_restore_drill_offsite_stale) fires at 35 days: a
# weekday-of-month slot recurs at 28 OR 35 days and would ticket on a
# healthy host every month that has five of that weekday; a fixed day
# recurs at 28–31, leaving ≥4 days of slack. Mid-month keeps it ≥ a week
# from the repo1 drill (first Saturday, 1st–7th) on the same volume. The
# nightly 02:00 backup can still be writing repo2 at 04:00 (2.5 h on
# 2026-10-15), so restore-drill.sh waits for pgbackrest-backup.service before
# choosing the backup and restores that night's differential.

[Unit]
Description=Monthly OFF-SITE pgBackRest restore-drill, repo2/S3 (multi-hour restore, network-bound; ADR-0043 / CS-110)
Documentation=https://github.com/Stellar-Index/StellarIndex/blob/main/docs/operations/runbooks/restore-drill.md#stellarindex_restore_drill_offsite_stale

[Timer]
OnCalendar=*-*-15 04:00:00 UTC
RandomizedDelaySec=1800
Persistent=true
Unit=restore-drill-offsite.service

[Install]
WantedBy=timers.target
