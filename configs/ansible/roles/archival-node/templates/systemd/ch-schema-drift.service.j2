{% set drift_live = ch_schema_drift_use_live | default(true) | bool %}
# systemd unit: ClickHouse schema DRIFT check (C6-008/C6-003).
#
# Rendered by Ansible. Runs /usr/local/bin/ch-schema-drift.sh, which
# compares the repo's founding lake DDL (deploy/clickhouse/tier1_schema.sql)
# against the live schema — engine (incl. args), PARTITION BY, ORDER BY,
# and the column-name list, per declared table.
#
# The snapshot answers "what IS the live schema". This answers "is it
# what the repo says it should be". Tier-1 DDL has always been
# hand-applied — there is no ClickHouse migration runner the way
# migrations/ covers Postgres — so an ORDER BY changed by hand during an
# incident produced no signal anywhere until a re-derive silently wrote a
# differently-sorted table.
#
# WHICH SIDE IT READS (ch_schema_drift_use_live, default TRUE since
# 2026-09-09). True = the check runs its own SHOW CREATE sweep, which is
# what "vs live" in the Description below means and the only reading that
# can answer the question. False = it compares against the newest
# ch-schema-snapshot capture instead: cheaper by one loopback sweep a day,
# but up to a day stale, blind to anything applied since, and — measured
# on r1 on 2026-09-09 — it reported 8 live tables as ABSENT purely because
# that day's deploy shipped a newer intent than the morning's capture.
# The Description and Environment=LIVE= below are BOTH rendered from that
# one variable, so the unit can never again describe a mode it does not
# set (ch-schema-drift-test.sh pins that).
#
# Ordered AFTER the snapshot (which lands at 03:40 + up to 10 min jitter):
# load-shaping in the default mode, and the correctness requirement in the
# ch_schema_drift_use_live: false mode.

[Unit]
Description=Stellar Index — ClickHouse schema drift check (repo intent vs {{ 'live' if drift_live else 'the newest daily snapshot' }})
Documentation=https://github.com/Stellar-Index/StellarIndex/blob/main/docs/adr/0043-backup-and-restore-strategy.md
After=clickhouse-server.service ch-schema-snapshot.service network-online.target
Wants=clickhouse-server.service

# Restart-storm limit — matches the sibling oneshots (systemd >=230
# ignores StartLimit* under [Service]).
StartLimitIntervalSec=1h
StartLimitBurst=3

[Service]
Type=oneshot
EnvironmentFile=-/etc/default/stellarindex-ops
Environment=INTENT={{ ch_schema_drift_intent | default('/usr/local/share/stellarindex/tier1_schema.sql') }}
Environment=SNAPSHOT_DIR={{ ch_schema_snapshot_dir | default('/var/lib/stellarindex/ch-schema-snapshot') }}
Environment=LIVE={{ 1 if drift_live else 0 }}
ExecStart=/usr/local/bin/ch-schema-drift.sh
# Exit 1 = drift, exit 2 = could-not-compare. BOTH are failures on
# purpose: "we could not check" must never be recorded as "checked, and
# fine" — that equivalence is the failure ADR-0043 was written after.
# No SuccessExitStatus here, deliberately.
User=root

# Sweeps SHOW CREATE and writes one .prom file: must never compete with ingest.
Nice=15
IOSchedulingClass=best-effort
IOSchedulingPriority=7

# A ~45-statement SHOW CREATE sweep over loopback plus a pure text
# comparison: sub-second. Bounded well above that so a wedged ClickHouse
# fails the run rather than pinning the timer.
TimeoutStartSec=10min
RuntimeMaxSec=10min

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=/var/lib/node_exporter/textfile_collector

[Install]
WantedBy=multi-user.target
