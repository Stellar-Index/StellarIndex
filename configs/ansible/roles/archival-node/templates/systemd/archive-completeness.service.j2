# systemd unit: archive-completeness verify daemon.
#
# Rendered by Ansible. Reflects r1's EFFECTIVE running config — the
# base unit plus the compute-to.conf + override.conf drop-ins are
# folded directly into this template (ARCHIVE_TO must be computed at
# start time or the verify is a no-op).
#
# Per ADR-0017 §"Daily completeness cron". Runs once on each timer
# tick (oneshot semantics); the timer file at
# archive-completeness.timer schedules the cadence.

[Unit]
Description=Stellar Index — archive-completeness verify (daily cron per ADR-0017)
Documentation=https://github.com/Stellar-Index/StellarIndex/blob/main/docs/operations/archive-completeness.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=-/etc/default/archive-completeness
EnvironmentFile=-/etc/default/stellarindex
EnvironmentFile=-/etc/default/stellarindex-ops
# ARCHIVE_TO is computed at start time from the indexer cursor —
# compute-archive-to.sh writes ARCHIVE_TO=<n> to the runtime env
# file below, which then overrides the Environment= default (systemd
# EnvironmentFile= always wins over a literal Environment=, regardless
# of directive order).
EnvironmentFile=-/run/archive-completeness.env

# Sensible defaults. Operators override via /etc/default/archive-completeness.
# ARCHIVE_FROM tracks the hot floor (ADR-0027 trim): below it the local
# archive is deliberately empty and completeness of that range is the
# cold tier's concern, verified by the cold-read canary instead.
#
# NOTE: there is deliberately no ARCHIVE_TO default here (#1179). It used
# to be `Environment=ARCHIVE_TO=0`, which the binary rejects outright
# ("-to is required", internal/ops/archive/archive_completeness.go).
# That default is inert as long as compute-archive-to.sh keeps running
# and succeeding (EnvironmentFile= always wins over Environment=), but
# it is a landmine for anyone who copies this block for a manual run,
# `systemctl cat`s the effective config expecting a real default, or
# hits the one path (ExecStartPre skipped or overridden) where it
# would reach the binary. Mirrors the already-fixed deploy/systemd/
# archive-completeness.service reference unit.
Environment=ARCHIVE_FROM={{ stellarindex_archive_hot_floor }}
Environment=TEXTFILE_OUTPUT=/var/lib/node_exporter/textfile_collector/archive_completeness.prom
Environment=REPORT_OUTPUT=/var/lib/galexie/last-completeness-report.json
Environment=WORKERS=8

ExecStartPre=/usr/local/sbin/compute-archive-to.sh
# 75 = run-heavy-job.sh skipped this fire (a lock was held): not a
# failure, but ExecMainStatus=75 keeps it distinct from a run.
SuccessExitStatus=75
# Queue behind another heavy job (host-wide and scheduled locks) for up to
# 12h instead of skipping the fire; TimeoutStartSec below covers wait + run.
Environment=HEAVY_JOB_LOCK_WAIT=43200
Environment=HEAVY_JOB_CLASS=scheduled
ExecStart=/usr/local/sbin/run-heavy-job.sh archive-completeness \
  /usr/local/bin/stellarindex-ops archive-completeness verify \
  -write \
  -from ${ARCHIVE_FROM} \
  -to ${ARCHIVE_TO} \
  -workers ${WORKERS} \
  -network {{ stellar_network | default('pubnet') }} \
  -textfile-output ${TEXTFILE_OUTPUT} \
  -output-file ${REPORT_OUTPUT}

# NOT de-privileged, unlike the sibling units: run-heavy-job.sh only
# creates its systemd-run scope (the memory cap and the disk watchdog) for
# a root caller, and warns and degrades to a bare exec otherwise. Moving
# the env file and report alone would not make User=stellarindex safe.
User=root
Group=root

# Hardening — read-only most of the filesystem, write only where we
# need to: archive root, the textfile output dir, the report dir.
ProtectSystem=full
PrivateTmp=true
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=/srv/history-archive /var/lib/galexie /var/lib/node_exporter

# A clean run is fast; a worst-case (lots of fallback chain
# fetches) shouldn't exceed 30 min. Hard-cap so a hung HTTP source
# can't wedge the timer. 45000s = that 30 min + the 12h lock wait.
TimeoutStartSec=45000

[Install]
WantedBy=multi-user.target
