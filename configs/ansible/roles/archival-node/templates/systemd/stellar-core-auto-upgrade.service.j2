# systemd service: install apt's newer stellar-core under galexie, verify the
# ledger tip advances, roll back if it does not. See the script header.
[Unit]
Description=Stellar Index — stellar-core auto-upgrade (apt candidate, verified, rollback)
Documentation=https://github.com/Stellar-Index/StellarIndex/blob/main/docs/operations/runbooks/stellar-node.md#stellar-stack-version-lag
After=network-online.target minio.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
Environment=STELLAR_CORE_PIN={{ stellar_core_version | default('') }}
ExecStart=/usr/local/sbin/stellar-core-auto-upgrade
# The script waits up to 45 min for the tip, twice when it rolls back.
TimeoutStartSec=6000
# No ProtectSystem: apt/dpkg must write /usr and /etc. No NoNewPrivileges:
# apt-get update drops to _apt via seteuid, which it forbids (r1: "seteuid 42
# failed"). Restarts go over D-Bus, so the cgroup/kernel protections are free.
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
