# systemd unit: nightly verify-archive Tier A run.
#
# Rendered by Ansible. Reflects r1's EFFECTIVE running config (the
# base unit + the override.conf + 10-deprioritize.conf drop-ins are
# folded directly into this template — simpler than templating
# drop-ins separately).
#
# Per docs/operations/archival-node-bringup.md §"Per-region trust +
# verification model". Runs once per timer tick; the cadence lives
# in verify-archive-tier-a.timer.
#
# This timer is intended to run on R1 only — the integrity leader
# per ADR-0016. R2/R3 trust R1 for chain integrity and run their own
# Tier A on a slower (weekly) cadence; that lives in a separate
# verify-archive-tier-a-weekly.{timer,service} when those regions'
# ansible role ships.

[Unit]
Description=Stellar Index — verify-archive Tier A (nightly chain-link integrity)
Documentation=https://github.com/Stellar-Index/StellarIndex/blob/main/docs/operations/archival-node-bringup.md
After=network-online.target
Wants=network-online.target

[Service]
# Type=notify + WatchdogSec replaces the previous
# Type=oneshot + fixed TimeoutStartSec: the binary signals READY=1
# at start, then WATCHDOG=1 every 30s. systemd SIGTERMs only on
# real silence (binary hung / crashed). WatchdogSec=1h gives 1h of
# stalled-without-progress slack — orders of magnitude more headroom
# than any guessed wall-clock cap, and tied to liveness rather than
# duration. Matching Go integration in cmd/stellarindex-ops/main.go.
Type=notify
NotifyAccess=main
WatchdogSec=1h

EnvironmentFile=-/etc/default/stellarindex-ops

# Defaults. Operators override via /etc/default/stellarindex-ops.
# MAX_RUNTIME=0 = uncapped: the binary's graceful self-cap is
# disabled, systemd's TimeoutStartSec is the only bound. The
# bootstrap full pass needs to run to completion to seed the
# -from-last-verified state file; a binary-side cap that fired
# mid-pass meant state never seeded and every run stayed a full
# pass (the Task #13 / 2026-05-19 incident).
# Cold-start floor only — normal runs resume from the state file's
# high-water (63.6M+, far above any floor). If the state file is ever
# lost, restarting from the hot floor instead of ledger 2 avoids a
# from-genesis walk over a range the local archive no longer holds.
Environment=VERIFY_ARCHIVE_FROM={{ stellarindex_archive_hot_floor | default(2) }}
Environment=VERIFY_ARCHIVE_WORKERS=12
Environment=VERIFY_ARCHIVE_MAX_RUNTIME=0
Environment=VERIFY_ARCHIVE_STATE_FILE=/var/lib/stellarindex/verify-archive-state.json
Environment=VERIFY_ARCHIVE_SAFETY_OVERLAP=5000
# P1-page export path (issue #282). The mismatch counter
# `stellarindex_verify_archive_mismatches_total` — the metric the
# `stellarindex_stellar_archive_divergence` page (severity: page)
# selects — used to leave the process ONLY through the opt-in
# `-metrics-listen` HTTP endpoint, which this unit never passed and
# which nothing scrapes (prometheus.r1.yml has no verify-archive job,
# and a one-shot job is gone between scrapes anyway). The P1 therefore
# had no producer and a real chain break surfaced only as the
# severity-TICKET `stellarindex_verify_archive_unit_failed`.
# `-textfile-output` writes the counter into node_exporter's
# textfile_collector dir (cumulative across runs, zero-seeded, and
# `tier`-labelled so tier-a and tier-b never expose the same series
# through the one node_exporter target) — the same pattern
# archive-completeness, supply-snapshot and sla-probe already use.
Environment=VERIFY_ARCHIVE_TEXTFILE=/var/lib/node_exporter/textfile_collector/verify_archive_tier_a.prom

# Incremental scheme (since 2026-05-14): -from-last-verified reads
# the prior run's high-water mark from the state file, then verifies
# only the [last_verified - safety_overlap, tip] window. Past LCM
# files are immutable so re-verifying them nightly is wasted compute.
#
# -from is the FALLBACK lower bound when the state file is missing
# or has no prior entry for this tier — typically a fresh deployment.
# That first-ever run is a full pass; subsequent runs are incremental.
#
# -to is omitted intentionally — verify-archive resolves the head
# ledger from the manifest at start time, so we always verify up to
# whatever the archive contained at run-launch.
# Routed through run-heavy-job.sh for the per-job singleton lock (C4-14 /
# INF-11): this is the longest heavy job (~13.8h first pass), so a slow run
# is the most likely to still be going when the next timer fires. The wrapper
# runs as User=stellarindex (non-root) so it takes the lock then `exec`s the
# binary in place — the payload stays the unit's MAIN pid, keeping Type=notify
# + NotifyAccess=main + WatchdogSec intact (a systemd-run scope would break it).
ExecStart=/usr/local/sbin/run-heavy-job.sh verify-archive \
  /usr/local/bin/stellarindex-ops verify-archive \
  -config /etc/stellarindex.toml \
  -from ${VERIFY_ARCHIVE_FROM} \
  -tier chain \
  -workers ${VERIFY_ARCHIVE_WORKERS} \
  -max-runtime ${VERIFY_ARCHIVE_MAX_RUNTIME} \
  -state-file ${VERIFY_ARCHIVE_STATE_FILE} \
  -from-last-verified \
  -safety-overlap ${VERIFY_ARCHIVE_SAFETY_OVERLAP} \
  -textfile-output ${VERIFY_ARCHIVE_TEXTFILE}

# De-privileged (CS-118, audit-2026-06-30) — the stellarindex user is
# created by 04-users.yml (CS-119). Reads the archive via S3 (network)
# and writes only the state file under /var/lib/stellarindex, which is
# stellarindex-owned (04-users.yml).
User=stellarindex
Group=stellarindex

# Hardening. The binary reads /etc/stellarindex.toml; the only write
# is the state file (logs go to journald).
ProtectSystem=full
PrivateTmp=true
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

# The textfile_collector dir is stellarindex-owned
# (10-observability.yml) and lives under /var, which ProtectSystem=full
# already leaves writable; listed explicitly so the write surface this
# unit needs is stated rather than inferred.
ReadWritePaths=/var/lib/node_exporter/textfile_collector

# With Type=notify + WatchdogSec=1h above, TimeoutStartSec only
# governs the time the binary has to signal READY=1 — essentially
# "did the process start cleanly". The walk's actual run-time is
# bounded by WatchdogSec (liveness, not wall-clock).
TimeoutStartSec=10m

# The first-ever verify run is a full ~13.8h pass. Deprioritize so
# it yields CPU/IO to the API + postgres during daytime hours
# rather than dragging p99.
CPUWeight=20
IOWeight=20

[Install]
WantedBy=multi-user.target
