# systemd unit: ADR-0033 completeness-verdict refresh.
#
# Rendered by Ansible. Runs run-compute-completeness.sh (a whole-pass driver)
# once per timer tick. Keeps `completeness_snapshots` — the authoritative
# "100% confidence in 100% coverage" verdict — fresh instead of frozen at
# whatever ledger the last manual run reached.
#
# Per ADR-0033 + ADR-0034 (-ch reads the certified ClickHouse lake, off the
# serving Postgres). The driver makes ONE `compute-completeness -ch -pass` call
# that proves recognition + substrate once at full range and reconciles each
# source's projection incrementally; the SDEX reconcile's ClickHouse memory is
# bounded inside the tool (25k-ledger CH windowing), so no wrapper-side chunking
# is needed.

[Unit]
Description=Stellar Index — ADR-0033 completeness-verdict refresh (daily)
Documentation=https://github.com/Stellar-Index/StellarIndex/blob/main/docs/architecture/completeness-verification.md
After=network-online.target postgresql.service clickhouse-server.service
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=-/etc/default/compute-completeness
EnvironmentFile=-/etc/default/stellarindex

# Defaults. Operators override via /etc/default/compute-completeness.
Environment=CONFIG_PATH=/etc/stellarindex.toml
Environment=CH_ADDR=127.0.0.1:9300

# 75 = run-heavy-job.sh skipped this fire (a lock was held): not a
# failure, but ExecMainStatus=75 keeps it distinct from a run.
SuccessExitStatus=75
# Queue behind another heavy job (host-wide and scheduled locks) for up to
# 12h instead of skipping the fire; TimeoutStartSec below covers wait + run.
Environment=HEAVY_JOB_LOCK_WAIT=43200
Environment=HEAVY_JOB_CLASS=scheduled
# Shares the job name with compute-completeness-sdex.service, so it queues
# (up to that unit's 390 min run) instead of skipping a night (GH-1229); the
# 12h wait above covers it.
ExecStart=/usr/local/sbin/run-heavy-job.sh compute-completeness /usr/local/sbin/run-compute-completeness.sh

# De-privileged — the stellarindex user is
# created by 04-users.yml (CS-119). Talks Postgres + ClickHouse over the
# loopback only; writes nothing to disk.
User=stellarindex
Group=stellarindex

# Read-only most of the filesystem; the driver writes nothing to disk (it
# talks to Postgres + ClickHouse over the loopback only).
ProtectSystem=full
PrivateTmp=true
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

# One -pass call proves recognition (~60s) + substrate once, then reconciles
# each source's new suffix — steady-state ticks finish in minutes. The first
# pass additionally seeds any never-verified source from genesis; cap generously.
# Whole seconds: the 43200 s lock wait + 180 min for the pass itself.
TimeoutStartSec=54000

[Install]
WantedBy=multi-user.target
