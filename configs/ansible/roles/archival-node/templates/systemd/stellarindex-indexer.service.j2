# Rendered by Ansible (archival-node role).
#
# CS-118 (audit-2026-06-30): runs de-privileged as the stellarindex
# service user with the hardening block from the in-repo unit at
# deploy/systemd/stellarindex-indexer.service (which was drifting
# unused while this template ran the daemon as root). The
# stellarindex user is created by 04-users.yml (CS-119).
# EnvironmentFile is read by systemd (PID 1), not the service user;
# it stays 0640 root:stellarindex.

[Unit]
Description=Stellar Index — indexer (Galexie → dispatcher → trades hypertable)
After=network-online.target postgresql@{{ postgres_version }}-main.service minio.service galexie.service redis-server.service
Wants=network-online.target

# Restart-storm limit — [Unit] directives per systemd.unit(5); systemd
# >=230 IGNORES StartLimit* under [Service]. More than StartLimitBurst
# NOTE (#371 F3): with the live-tail retry budget in force a start
# cycle is ~5min10s, so a PERMANENTLY broken config can never reach
# 60 starts inside 15 min and `systemd_unit_failed` will not fire for
# it. The honest cover for that fault is
# `stellarindex_ingestion_ledger_stalled` (page, ~10 min): the
# committed LEDGER cursor stops advancing. NOT `all_sources_stopped`,
# which this comment named until 2026-09-03 — the CEX/FX connectors
# share this binary and keep its input moving through a lake outage.
# The ~5min10s figure holds only because the budget covers the datastore
# OPEN as well as the walk (ledgerstream.retryLiveStart). The open +
# schema load run BEFORE the SDK fetch worker that spends the in-walk
# budget exists, so until that outer retry landed a lake outage present
# at START failed in ~1s, the cycle collapsed to RestartSec, and 60
# starts DID fit inside 15 min — the unit parked in `failed` and stayed
# parked after MinIO came back.
# Keep this in lockstep with deploy/systemd/stellarindex-indexer.service.
# restarts within StartLimitIntervalSec parks the unit in `failed`,
# which node_systemd_unit_state{state="failed"} raises a TICKET on
# (`stellarindex_systemd_unit_failed`, for: 15m — not a page) instead
# of hot-looping forever (audit-2026-07-23 REL-resource-governance —
# this had drifted from the deploy/systemd/*.service reference copies).
#
# Sized as a DEPENDENCY-OUTAGE budget (#371 F3): with RestartSec=10s
# below, 60 restarts is ~10 minutes of continuous failure before the
# unit parks — longer than a MinIO or Postgres restart (2-3 min on r1,
# including a config apply) — and the interval must exceed 60 × 10s =
# 600s or the burst could never accumulate inside the window and the
# unit would hot-loop forever instead of parking. Was 10/5min, i.e.
# ~100 SECONDS, so a dependency blip parked ingest in `failed` before
# the dependency had finished restarting. Keep in lockstep with
# deploy/systemd/stellarindex-indexer.service.
StartLimitIntervalSec=15min
StartLimitBurst=60

[Service]
Type=simple
User=stellarindex
Group=stellarindex
WorkingDirectory=/var/lib/stellarindex
EnvironmentFile=/etc/default/stellarindex
ExecStart=/usr/local/bin/stellarindex-indexer -config /etc/stellarindex.toml
ExecStop=/bin/kill -TERM $MAINPID

LimitNOFILE=1048576
Restart=on-failure
RestartSec=10s

# Memory ceiling — bounds a leak so it can't starve Postgres/ClickHouse
# on this shared, memory-tight host (188 GiB total, already running
# close to capacity per r1-deployment-state.md F-1209). MemoryHigh
# throttles (cgroup reclaim) well before the hard MemoryMax kill.
# Deliberately generous for a lean Go service — conservative starting
# point to avoid a false-positive OOM-kill outage; tune down once
# real steady-state RSS is observed.
MemoryHigh=4G
MemoryMax=8G

# Hardening — read-only most of the filesystem, write only the
# working dir. Mirrors deploy/systemd/stellarindex-indexer.service.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=/var/lib/stellarindex

[Install]
WantedBy=multi-user.target
