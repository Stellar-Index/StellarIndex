# systemd timer: weekly full-range lending interest proof.
#
# Rendered by Ansible where lending_interest_prove_enabled is set. Companion to
# lending-interest-prove-full.service.
#
# Time slot: Saturday 10:05 UTC + up to 10 min jitter, clear of the daily
# proof (07:35) and the Wednesday/Sunday completeness re-proofs; the heavy-job
# wrapper queues it behind any other heavy job. Weekly matches the 8-day
# threshold of stellarindex_lending_interest_proof_stale for this series.
# Persistent=true: if the box was off on Saturday morning, fire on next boot.

[Unit]
Description=Weekly full-range lending interest proof
Documentation=https://github.com/Stellar-Index/StellarIndex/blob/main/docs/operations/runbooks/ops-job-stalled.md#lending-interest-proof-failed

[Timer]
OnCalendar=Sat *-*-* 10:05:00 UTC
RandomizedDelaySec=600
Persistent=true
Unit=lending-interest-prove-full.service

[Install]
WantedBy=timers.target
