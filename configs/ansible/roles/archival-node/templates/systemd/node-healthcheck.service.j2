[Unit]
Description=Archival-node health probe — reports to Healthchecks.io
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# The ping URL lives in /etc/default/node-healthcheck (root:root 0600).
# systemd reads it as root before dropping to the dynamic user; the
# script only sources the file itself when run by hand as root.
EnvironmentFile=-/etc/default/node-healthcheck
ExecStart=/usr/local/bin/node-healthcheck.sh

# Unprivileged: curl over localhost, `systemctl is-active/cat/show`,
# `zpool list` (/dev/zfs is 0666) and df all work without root, and the
# only write is a scratch file in the private /tmp.
DynamicUser=yes

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
