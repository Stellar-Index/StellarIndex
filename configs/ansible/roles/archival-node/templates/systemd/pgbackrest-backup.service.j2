[Unit]
Description=pgBackRest scheduled backup (stellarindex stanza)
Documentation=https://github.com/Stellar-Index/StellarIndex/blob/main/docs/operations/runbooks/backup-failed.md
After=postgresql.service network-online.target
Wants=postgresql.service

[Service]
Type=oneshot
User=postgres
Group=postgres
# The wrapper emits per-repo textfile metrics into the node_exporter
# collector dir, which is stellarindex:stellarindex 0775
# (10-observability.yml). Grant the group here rather than mutating the
# postgres account; picked up on each (oneshot) start, no restart of
# postgresql needed.
SupplementaryGroups=stellarindex
ExecStart=/usr/local/bin/pgbackrest-backup.sh
# Keep backup I/O off the critical path of live ingest.
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
