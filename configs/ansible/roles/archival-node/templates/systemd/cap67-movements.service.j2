# systemd unit: cap67 movements derive — CONTINUOUS FOLLOW DAEMON (5.3).
#
# Rendered by Ansible. Derives post-P23 account movements for EVERY
# asset (native XLM included) from the lake's CAP-67 transfer events
# into stellar.account_movements (provenance cap67_derived), resuming
# from stellar.cap67_movements_watermark.
#
# This is the "true up-to-the-second" evolution the timer-driven oneshot
# reserved for a follow-worker. `-follow` runs it as a long-lived daemon:
# catch up to the CONTIGUOUS lake tip (the watermark-gated range that
# never steps past a near-tip hole — see Cap67Range / #174), sleep
# FOLLOW_INTERVAL, repeat. The FIRST catch-up after provisioning is still
# the multi-hour P23→tip backfill (one loop iteration); it then follows.
# Crash-safe: Restart=always + resume-from-watermark; a transient
# ClickHouse error holds the watermark and retries next tick (no ledger
# skipped). Graceful SIGTERM: the loop exits cleanly mid-derive.
#
# REPLACES the cap67-movements.timer + oneshot. The timer must be
# stopped/disabled when this daemon is enabled — two writers would race
# the watermark. (systemd's one-instance rule already prevents a second
# cap67-movements.service, but leave no orphan timer firing it.)

[Unit]
Description=Stellar Index — cap67 account-movements follow daemon (real-time)
Documentation=https://github.com/Stellar-Index/StellarIndex/blob/main/docs/operations/open-fixes-inventory-2026-08-08.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-/etc/default/cap67-movements
EnvironmentFile=-/etc/default/stellarindex

Environment=CH_ADDR=127.0.0.1:9300
Environment=WINDOW=50000
Environment=FOLLOW_INTERVAL=2s
Environment=EXTRA_FLAGS=

ExecStart=/usr/local/bin/stellarindex-ops ch-cap67-movements \
  -follow \
  -follow-interval ${FOLLOW_INTERVAL} \
  -ch-addr ${CH_ADDR} \
  -window ${WINDOW} \
  -write \
  ${EXTRA_FLAGS}

# Crash-safe daemon: on any non-graceful exit, restart and resume from
# the persisted watermark. RestartSec avoids a hot crash-loop against a
# wedged ClickHouse.
Restart=always
RestartSec=10s

# De-privileged, same shape as the sibling oneshots (CS-118/CS-119).
User=stellarindex
Group=stellarindex

ProtectSystem=strict
PrivateTmp=true
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

# Memory ceiling — streams + decodes lake events in 50k-ledger windows
# with 50k-row insert batches; 4G is far above a healthy run (incl. the
# initial backfill loop) and far below the blast radius (the 2026-07-05
# wedge class). Swap-kill, not swap-crawl.
MemoryMax=4G
MemorySwapMax=0
# Batch-class weights: this must never starve galexie's captive core.
CPUWeight=25
IOWeight=25

[Install]
WantedBy=multi-user.target
