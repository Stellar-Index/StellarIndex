[Unit]
Description=pgBackRest Exporter (Prometheus)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=pgbackrest_exporter
Group=pgbackrest_exporter
# The exporter shells out to `pgbackrest info`, which must read
# /etc/pgbackrest/pgbackrest.conf (postgres:postgres 0640, it holds the
# repo credentials). Without this the exporter starts but reports no stanza.
SupplementaryGroups=postgres
ExecStart=/usr/local/bin/pgbackrest_exporter \
  --web.listen-address=127.0.0.1:9854 \
  --web.telemetry-path=/metrics \
  --collect.interval=600

Restart=on-failure
RestartSec=10s

# Lock it down — only reads pgbackrest CLI output + writes prometheus
# metrics over a loopback socket.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
