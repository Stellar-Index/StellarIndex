# Rendered by Ansible (archival-node role).
#
# The INTERNET-FACING API runs as its own service user
# ({{ stellarindex_api_os_user }}, 04-users.yml), never the ingest daemons'
# uid. Its env file /etc/default/stellarindex-api is 0640
# root:{{ stellarindex_api_os_user }} and holds only the names it reads.
# Not covered yet: the Postgres, ClickHouse and Redis credentials it holds stay
# as strong as the daemons' until each host sets least-privilege ones for the API.
# Caddy terminates TLS and proxies to :3000, so no privileged port bind.

[Unit]
Description=Stellar Index — REST + SSE API server
# After= only, no Wants=: it orders against a co-located ClickHouse and is a
# no-op where the lake is remote; the API's boot dial retry covers the rest.
After=network-online.target postgresql@{{ postgres_version }}-main.service redis-server.service clickhouse-server.service
Wants=network-online.target

# Restart-storm limit — [Unit] directives per systemd.unit(5); systemd
# >=230 IGNORES StartLimit* under [Service]. More than StartLimitBurst
# restarts within StartLimitIntervalSec parks the unit in `failed`,
# which node_systemd_unit_state{state="failed"} pages on instead of
# hot-looping forever (resource governance — this
# had drifted from the deploy/systemd/*.service reference copies).
# RestartSteps/RestartMaxDelaySec below back restarts off to 2 min, which keeps
# even an hours-long Postgres outage under this burst, so the unit recovers on
# its own instead of parking; stellarindex_api_down covers it while it is down.
StartLimitIntervalSec=15min
StartLimitBurst=100

[Service]
Type=simple
User={{ stellarindex_api_os_user }}
Group={{ stellarindex_api_os_user }}
WorkingDirectory=/
EnvironmentFile=/etc/default/stellarindex-api
UnsetEnvironment=STELLARINDEX_CLICKHOUSE_OPS_USER STELLARINDEX_CLICKHOUSE_OPS_PASSWORD
ExecStart=/usr/local/bin/stellarindex-api -config /etc/stellarindex.toml

LimitNOFILE=1048576
Restart=on-failure
RestartSec=5s
RestartSteps=10
RestartMaxDelaySec=2min

# Memory ceiling — bounds a leak so it can't starve Postgres/ClickHouse
# on this shared, memory-tight host (188 GiB total, already running
# close to capacity per r1-deployment-state.md). MemoryHigh
# throttles (cgroup reclaim) well before the hard MemoryMax kill.
# Deliberately generous for a lean Go service — conservative starting
# point to avoid a false-positive OOM-kill outage; tune down once
# real steady-state RSS is observed.
MemoryHigh=4G
MemoryMax=8G

# Hardening. Mirrors deploy/systemd/stellarindex-api.service and is pinned by
# scripts/ci/lint-systemd-hardening.sh. Its own uid plus ProtectProc=invisible
# keep sibling daemons' /proc entries (environ, root) out of reach. ProcSubset=pid
# is not set: it hides /proc/sys/net/core/somaxconn, cutting Go's listen backlog to 128.
ProtectProc=invisible
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
# Its own env file too: systemd reads it before the sandbox, and hiding it keeps
# a hijacked wabt child from reading the API's secrets off disk.
InaccessiblePaths=-/run/lock -/etc/default/stellarindex -/etc/default/stellarindex-api -/etc/default/galexie -/etc/default/galexie-backfill -/etc/default/stellarindex-ops -/etc/clickhouse-client
# Caps the wabt children it runs on uploaded WASM; EPERM, not SIGSYS, on a miss.
TasksMax=4096
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
