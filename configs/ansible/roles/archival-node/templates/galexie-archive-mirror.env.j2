# /etc/default/galexie-archive-mirror — rendered by Ansible (archival-node
# role, tag galexie-archive-mirror). Do not edit by hand.
#
# Read by galexie-archive-mirror.service (EnvironmentFile). DEST_ENDPOINT
# empty means no off-site target: the script reports configured=0 and
# exits 1, so the unit shows failed and
# stellarindex_galexie_archive_mirror_stale tickets the host.
#
# The mc alias itself (DEST_ALIAS) is configured separately by the role
# with `mc alias set` (credentials on stdin, never on argv or in this
# file) — this file only carries what the script needs to decide whether
# a target exists and where to mirror to.
DEST_ENDPOINT={{ galexie_archive_mirror_s3_endpoint | default('') }}
DEST_ALIAS={{ galexie_archive_mirror_dest_alias | default('r2-archive') }}
DEST_BUCKET={{ galexie_archive_mirror_dest_bucket | default('stellarindex-galexie-archive') }}
SOURCE_ALIAS={{ galexie_archive_mirror_source_alias | default('local/galexie-archive') }}
TEXTFILE_DIR=/var/lib/node_exporter/textfile_collector
