# {{ ansible_managed }}
# pgBackRest configuration — templated from the live r1 config
# (fetched 2026-07-02) + the ADR-0043 offsite repo2 block.
#
# repo1 = fast local restore copy (SAME failure domain as the DB —
# that is exactly why repo2 exists).
# repo2 = the survival copy: offsite S3-compatible object storage
# (CS-111). Rendered only when pgbackrest_repo2_s3_bucket is set.
#
# SECRETS: the cipher passphrases and the repo2 S3 key pair are
# vault-managed inventory vars rendered INTO this file — pgbackrest has
# no env-file form that also reaches archive_command inside the postgres
# server process, so the postgres-owned 0640 file is the upstream
# pattern. Treat the rendered file as secret material: the templating
# task sets `diff: false` so `--check --diff` never prints it
# (audit-2026-08-28 backup-restore-7).
#
# ENCRYPTION (audit-2026-07-23 F4-F2): a pgBackRest repo's cipher is
# fixed at `stanza-create` time and CANNOT be flipped on an existing
# repo — `stanza-upgrade` does not re-encrypt, and pgbackrest refuses to
# read a repo whose cipher-type disagrees with its stored config. So
# these vars only take effect on a repo created (or re-created) with
# them set; changing them on a live stanza breaks every existing backup
# until the repo is rebuilt. The full procedure, including what is lost
# and in what order, is docs/operations/pgbackrest-encryption.md.

[global]
repo1-path=/var/lib/pgbackrest
repo1-retention-full=2
repo1-bundle=y
repo1-block=y
{% if pgbackrest_repo1_cipher_pass | default('') != '' %}
# repo1 encrypted at rest by US. The passphrase is vault-managed and is
# THE ONLY WAY to read these backups — losing it loses the repo (see
# docs/operations/pgbackrest-encryption.md §Key custody).
repo1-cipher-type=aes-256-cbc
repo1-cipher-pass={{ pgbackrest_repo1_cipher_pass }}
{% else %}
# repo1 is UNENCRYPTED (pgbackrest's default cipher-type=none). Every
# row of the database — API keys, customer records, webhook secrets — sits in
# plaintext under repo1-path, protected only by filesystem permissions.
# This state is reachable only with pgbackrest_repo1_unencrypted_ack
# explicitly set (18-pgbackrest-backup.yml asserts it); to fix it, set
# pgbackrest_repo1_cipher_pass from vault and follow
# docs/operations/pgbackrest-encryption.md — the repo must be re-created,
# it cannot be converted in place.
{% endif %}
{% if pgbackrest_repo2_s3_bucket | default('') != '' %}
repo2-type=s3
repo2-s3-endpoint={{ pgbackrest_repo2_s3_endpoint }}
repo2-s3-bucket={{ pgbackrest_repo2_s3_bucket }}
repo2-s3-region={{ pgbackrest_repo2_s3_region | default('auto') }}
repo2-s3-key={{ pgbackrest_repo2_s3_key }}
repo2-s3-key-secret={{ pgbackrest_repo2_s3_key_secret }}
repo2-path=/pgbackrest
repo2-retention-full=4
repo2-bundle=y
repo2-block=y
# Offsite copies are encrypted at rest by US, not just the provider.
repo2-cipher-type=aes-256-cbc
repo2-cipher-pass={{ pgbackrest_repo2_cipher_pass }}
{% endif %}
compress-type=zst
compress-level=3
process-max=4
log-level-console=info
log-level-file=detail
start-fast=y
delta=y
archive-async=y
spool-path=/var/spool/pgbackrest

[stellarindex]
pg1-path=/var/lib/postgresql/{{ postgres_version | default(15) }}/main
pg1-port=5432
pg1-user=postgres
pg1-database=postgres
