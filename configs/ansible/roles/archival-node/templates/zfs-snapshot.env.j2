# /etc/default/zfs-snapshot — rendered by Ansible (archival-node role,
# tag zfs-snapshots). Do not edit by hand. No secrets.
#
# Read by zfs-snapshot.service (EnvironmentFile) AND by
# scripts/ops/zfs-snapshot-now.sh, so a hand-taken pre-DDL snapshot uses
# the same dataset list and free-space floor the timer does.
ZFS_SNAPSHOT_POOL={{ zfs_data_pool_name }}
# Quoted: the value carries spaces and is read both by systemd (EnvironmentFile)
# and by a shell `set -a; . file`.
ZFS_SNAPSHOT_DATASETS="{% for d in zfs_snapshot_datasets %}{{ zfs_data_pool_name }}/{{ d.name }}:{{ d.retention_days }}{% if not loop.last %} {% endif %}{% endfor %}"
ZFS_SNAPSHOT_MIN_FREE_BYTES={{ zfs_snapshot_min_free_bytes }}
TEXTFILE_DIR=/var/lib/node_exporter/textfile_collector
