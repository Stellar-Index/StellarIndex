# Rendered by Ansible to /etc/default/stellarindex-api, root:{{ stellarindex_api_os_user }} 0640.
# The public API's ONLY env file: the names it reads and nothing else
# (allow-list pinned by scripts/ci/lint-systemd-hardening.sh). Each shared
# name renders the same value as in stellarindex.env.j2
# (scripts/ci/ansible-api-env-test.sh).

{% if postgres_pass_stellarindex_api | default('') | length > 0 %}
STELLARINDEX_POSTGRES_DSN={{ postgres_dsn_stellarindex_api }}
{% else %}
STELLARINDEX_POSTGRES_DSN={{ postgres_dsn_stellarindex }}
{% endif %}
STELLARINDEX_REDIS_PASSWORD={{ redis_password }}

MASSIVE_API_KEY={{ vault_massive_api_key | default('') }}
OPENEXCHANGERATES_APP_ID={{ vault_openexchangerates_app_id | default('') }}

{% if (vault_resend_api_key | default('', true) | string | trim) == ''
      and (region_deployment | default('production')) == 'production'
      and (stellarindex_dashboard_base_url | default('https://stellarindex.io')) != '' %}
{{ undef(hint='vault_resend_api_key is empty on a production host that serves the dashboard (RLT-321): no sign-in email could be delivered. Set it in the region secrets vault, or set stellarindex_dashboard_base_url to "" to unmount the dashboard.') }}
{% endif %}
STELLARINDEX_RESEND_API_KEY={{ vault_resend_api_key | default('') }}
{% if (vault_dashboard_code_secret | default('', true) | string | trim) == ''
      and (stellarindex_dashboard_base_url | default('https://stellarindex.io')) != '' %}
{{ undef(hint='vault_dashboard_code_secret is empty on a host that serves the dashboard: the API would refuse to start (passkeys need a shared secret). Set it in the region secrets vault, or set stellarindex_dashboard_base_url to "" to unmount the dashboard.') }}
{% endif %}
STELLARINDEX_DASHBOARD_CODE_SECRET={{ vault_dashboard_code_secret | default('') }}
STELLARINDEX_WEBHOOK_SEAL_KEY={{ vault_webhook_seal_key }}

STELLARINDEX_CLICKHOUSE_SERVING_PASSWORD={{ stellarindex_clickhouse_serving_api_password }}
{% if clickhouse_live_daemon_profile_enabled | default(false) | bool and (clickhouse_live_daemon_password | default('')) | length > 0 %}
STELLARINDEX_CLICKHOUSE_LIVE_USER={{ clickhouse_live_daemon_user }}
STELLARINDEX_CLICKHOUSE_LIVE_PASSWORD={{ clickhouse_live_daemon_password }}
{% endif %}
