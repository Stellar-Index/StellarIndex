# Stellar Index — Caddy reverse proxy.
#
# MANAGED BY ANSIBLE (archival-node/19-caddy.yml) since the 2026-07-03
# drift audit — this was the last hand-managed public-edge config.
# configs/caddy/Caddyfile.api in the repo is generated-from/kept-in-sync
# with this template; edit HERE.
# Auto-HTTPS via Let's Encrypt; fronts the API (and the showcase if
# served from this box; today the showcase is on Cloudflare Pages
# per CLAUDE.md, so this block stays inert until DNS for the showcase
# is repointed).
#
# Cert acquisition needs:
#   - api.stellarindex.io A record → 136.243.90.96
#   - Ports 80 + 443 reachable from the public internet
# Until DNS lands, Caddy retries acquisition every few minutes and
# falls back to its internal CA for testing on the IP directly.
#
# Operator email is for Let's Encrypt account registration —
# expiration warnings and CA-required notices land here.
{

	# ─── PII redaction for EVERY logger in this process ────────────
	# The site block below attaches this same filter to its own access
	# logger. That is not enough: two other loggers in the same process
	# emit an unfiltered `request` object, and both were observed doing
	# it on r1 (#346 F2b).
	#
	#   1. `http.handlers.reverse_proxy` runtime warnings ("aborting
	#      with incomplete response") embed request.uri and headers.
	#      Over 24h: 5 lines carrying a query string, 11 carrying a
	#      Referer. Those queries happened to be SSE stream params —
	#      but a client that disconnects mid-response on
	#      /v1/auth/callback?token=... would be logged verbatim here.
	#   2. The catch-all default access logger (bare-IP and legacy-host
	#      :80 traffic, plus internet background noise) is unfiltered:
	#      4 lines/24h with a query, every one echoing Location.
	#
	# Filtering the DEFAULT logger covers both, because both write to
	# it. The site block keeps its own copy: `log` in a site block
	# replaces the default for that site rather than layering on it.
	log {
		format filter {
			wrap json
			fields {
				request>uri regexp "[?].*" "?<redacted>"
				request>headers>X-Api-Key delete
				request>headers>Referer delete
				request>headers>X-Reason delete
				resp_headers>Location delete
			}
		}
	}
	email tls@stellarindex.io
	# Auto-HTTPS on by default. If we ever need a no-DNS test mode:
	#   auto_https disable_redirects
	# but leave it on for production.

	# ─── Real client IP from Cloudflare ────────────────────────────
	# Without this block, Caddy sees Cloudflare's edge IP as the
	# immediate peer, propagates that as X-Forwarded-For, and the
	# API logs every request as if it came from a CF edge POP.
	# Worse: per-IP rate-limit buckets become per-CF-edge buckets,
	# so a single CF edge hitting the burst threshold blocks every
	# customer behind it.
	#
	# Fix: trust X-Forwarded-For + CF-Connecting-IP only when the
	# immediate peer is in Cloudflare's published IP ranges (CF
	# guarantees these and changes them rarely — refresh from
	# https://www.cloudflare.com/ips-v4 + ips-v6 on quarterly
	# audits or when CF publishes a notice).
	#
	# `client_ip_headers` order matters: CF-Connecting-IP first
	# (canonical for CF-fronted services), then X-Forwarded-For
	# (defensive fallback if CF-Connecting-IP is ever stripped
	# upstream). Caddy substitutes {client_ip} with the resolved
	# value; the API's trusted_proxy_cidrs (still 127.0.0.1/32)
	# then trusts Caddy's downstream X-Forwarded-For.
	servers {
		trusted_proxies static \
			173.245.48.0/20 \
			103.21.244.0/22 \
			103.22.200.0/22 \
			103.31.4.0/22 \
			141.101.64.0/18 \
			108.162.192.0/18 \
			190.93.240.0/20 \
			188.114.96.0/20 \
			197.234.240.0/22 \
			198.41.128.0/17 \
			162.158.0.0/15 \
			104.16.0.0/13 \
			104.24.0.0/14 \
			172.64.0.0/13 \
			131.0.72.0/22 \
			2400:cb00::/32 \
			2606:4700::/32 \
			2803:f800::/32 \
			2405:b500::/32 \
			2405:8100::/32 \
			2a06:98c0::/29 \
			2c0f:f248::/32
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

# ─── API ──────────────────────────────────────────────────────────
{{ caddy_site_addresses }} {
	# Trust X-Forwarded-* headers from Caddy itself (the API's
	# trusted_proxy_cidrs config should include 127.0.0.1/32 so it
	# honours the headers Caddy sets).
	header {
		# Standard hardening — Caddy sets some by default; explicit
		# values here belt-and-braces in case of upstream regression.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Allow CORS at this layer too; the API also CORS-handles per
		# cfg.API.AllowedOrigins.
		-Server
	}

	# Manual serving kill-switch (audit-2026-07-23 serving-killswitch).
	# Divergence/anomaly conditions only raise alerts today — there was
	# no way to actually stop serving during a live data-integrity
	# incident short of stopping the API systemd unit (which also kills
	# /v1/healthz + /metrics observability). Engage:
	#   sudo touch /etc/caddy/MAINTENANCE_MODE
	# Disengage:
	#   sudo rm /etc/caddy/MAINTENANCE_MODE
	# No reload needed either way — `file` is evaluated per-request.
	# `root` below only scopes the file-existence check; it does not
	# enable static file serving (no file_server directive is present).
	root * /etc/caddy
	@maintenance file /MAINTENANCE_MODE
	respond @maintenance "Stellar Index is temporarily in maintenance mode. Please check https://status.stellarindex.io for updates." 503 {
		close
	}

	# Block the Prometheus metrics endpoint from the public domain.
	# The API binary serves /metrics on :3000 alongside /v1/* (one
	# port = one ServeMux), and the catch-all reverse_proxy below
	# would otherwise forward the public hit straight through. Local
	# Prometheus scraping uses 127.0.0.1:3000/metrics directly (per
	# `prometheus.r1.yml`) and is unaffected — only the public-facing
	# api.stellarindex.io path is closed. Surface area note: Go
	# runtime stats, request counters, and per-source ingest gauges
	# leaked operational fingerprinting to anyone hitting the public
	# URL; status.stellarindex.io is the right surface for public
	# transparency.
	respond /metrics 404 {
		close
	}

	# ── SSE: stream paths need immediate flushing ───────────────────
	# Measured on r1 2026-08-03: the API's own :3000 listener streams
	# /v1/price/stream correctly (`:connected`, `:keepalive` and
	# price_update frames arrive within milliseconds), but the SAME
	# request through Caddy — bypassing Cloudflare entirely, straight
	# to 127.0.0.1:443 — returned ZERO bytes over 25s. The response
	# was being buffered, so every external consumer of the documented
	# SSE endpoints connected, received HTTP 200 with
	# `Content-Type: text/event-stream`, and then waited forever with
	# no data and no heartbeat. Caddy's automatic streaming detection
	# did not engage here, so pin it explicitly for the stream routes.
	#
	# Scoped to /v1/*/stream deliberately: `flush_interval -1` disables
	# response buffering for every request it covers, which is exactly
	# right for a long-lived event stream and needless overhead for the
	# ordinary JSON routes the catch-all below serves.
	@sse path_regexp sse ^/v1/.*/stream$
	handle @sse {
		reverse_proxy localhost:3000 {
			flush_interval -1
			header_up Host {host}
			header_up X-Real-IP {client_ip}
			header_up X-Forwarded-For {client_ip}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# Health probe — Caddy reverse_proxy active health-check.
	# Drops the upstream from rotation if /v1/healthz starts returning
	# non-200, surfaces in /metrics. With one upstream this means
	# 502 on probe failure, but it's the right signal.
	reverse_proxy localhost:3000 {
		health_uri /v1/healthz
		health_interval 10s
		health_timeout 3s
		health_status 200
		# Forward the original Host header so the API can read it
		# (subdomain-based routing isn't in use today, but leaves
		# the door open).
		header_up Host {host}
		# {client_ip} is Caddy's resolved real-client IP from the
		# global trusted_proxies + client_ip_headers config above —
		# safe to forward because it's only set when the immediate
		# peer is in CF's published IP ranges. Forwarding
		# {remote_host} here would re-introduce the bug (CF edge IP
		# instead of real client). The API already trusts
		# X-Forwarded-For from 127.0.0.1 (Caddy itself), so the
		# resolved value flows through to the rate-limit and access-
		# log layers correctly.
		header_up X-Real-IP {client_ip}
		header_up X-Forwarded-For {client_ip}
		header_up X-Forwarded-Proto {scheme}
	}

	# Access logs — JSON to journald, picks up centralized log
	# aggregation (Loki) when that lands.
	log {
		output stdout
		# Redact the WHOLE query string, on both sides of the request,
		# plus the credential-bearing headers Caddy has never heard of.
		# Caddy's JSON access log records request.uri verbatim,
		# INCLUDING the query — and
		# /v1/auth/callback?token=<plaintext> carries a live single-use
		# dashboard credential, while /v1/signup/verify?token=<plaintext>
		# carries the email-verification one. Both were landing in
		# journald and shipping to Loki on a 720h retention, so anyone
		# with Grafana read access could mint a session for any account
		# that signed in during the window. The API's own logger already
		# refuses to log query parameters for exactly this reason
		# (internal/api/v1/middleware/logger.go) — that guarantee was
		# being defeated one layer up (cold audit 2026-08-04).
		#
		# The first version of this filter ENUMERATED the one parameter
		# to redact (`token`), so every parameter added since leaked by
		# default — which is how /v1/account/admin/lookup?email=<customer
		# email> put customer addresses in the edge log. The inverse, an
		# allow-list, is not expressible here: Caddy's `query` filter can
		# only NAME parameters to act on, and an allow-list written as a
		# regexp over the uri is not safe either — an unencoded `&`
		# inside a value (legal in an email local-part) ends the match
		# and the tail is logged verbatim. So the edge keeps NO query
		# values at all.
		#
		# Nothing diagnosable is lost. Which query values are safe to log
		# is already decided once, in Go, by a tested allow-list with a
		# length bound and control-character stripping — QueryShape in
		# internal/api/v1/middleware/slow_query_shape.go, attached by the
		# API's own logger to every request over the p99 SLA target. The
		# edge does not need a second, weaker copy of that rule.
		#
		# Request headers: Caddy blanks Authorization / Cookie /
		# Set-Cookie / Proxy-Authorization itself (the `log_credentials`
		# default), which covers Bearer keys and the dashboard session
		# cookie. But X-API-Key is OUR name for the customer's live API
		# key (docs/getting-started.md; bearerOrXKey in
		# internal/api/v1/middleware/auth.go) and Caddy has never heard
		# of it — it was logged in full, replayable by anyone with
		# Grafana read access. Referer can carry another origin's query
		# string (a dashboard link with its ?token= still in it), and
		# X-Reason is staff free text on the admin routes, which belongs
		# in the audit table it is already written to, not here.
		#
		# Response headers: redacting only the request would still leak,
		# because TrailingSlashRedirect
		# (internal/api/v1/middleware/trailingslash.go) answers
		# /v1/account/admin/lookup/?email=<customer email> with a 308
		# whose Location is the same URI, QUERY PRESERVED — and Caddy
		# logs resp_headers. log_credentials knows nothing about
		# Location, and the redirect target is derivable from the
		# request uri we already log, so drop the header outright.
		#
		# Header names must be in Go's canonical MIME form, which is how
		# net/http parses them and therefore the key Caddy logs them
		# under — a mismatched case matches nothing and fails open
		# SILENTLY, so the exact spellings are pinned by
		# internal/config/caddy_access_log_test.go.
		#
		# NOTE: takes effect only after an ansible run with --tags caddy.
		format filter {
			wrap json
			fields {
				# `[?]` rather than `\?`: a character class needs no
				# backslash, so the pattern reads identically to the
				# Caddyfile lexer and to Go's regexp, which is the
				# engine this filter runs on. The first `?` in a request
				# URI is the query delimiter, so this drops the query
				# and only the query — the path, the log's primary
				# diagnostic, survives.
				request>uri regexp "[?].*" "?<redacted>"
				request>headers>X-Api-Key delete
				request>headers>Referer delete
				request>headers>X-Reason delete
				resp_headers>Location delete
			}
		}
		# Skip /v1/healthz spam from the active health check.
		# It runs every 10s; not interesting in the access log.
	}
}

