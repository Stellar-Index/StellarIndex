#!/usr/sbin/nft -f
#
# Stellar Index archival-node firewall.
#
# Policy: default-deny on input; SCP peer + SSH open publicly;
# internal-only services restricted to internal_cidrs; Caddy's 80/443
# public unless http_origin_lock_enabled restricts them to the CDN edge.

flush ruleset

table inet filter {

  # ─── Sets of trusted CIDRs ─────────────────────────────────────
  set internal_v4 {
    type ipv4_addr
    flags interval
    elements = {
{% for cidr in internal_cidrs if ':' not in cidr %}
      {{ cidr }}{% if not loop.last %},{% endif %}
{% endfor %}
    }
  }

  set ssh_allowed_v4 {
    type ipv4_addr
    flags interval
    elements = {
{% for cidr in allowed_ssh_cidrs if ':' not in cidr %}
      {{ cidr }}{% if not loop.last %},{% endif %}
{% endfor %}
    }
  }

{% set origin_lock = (http_origin_lock_enabled | default(false) | string | lower) in ['true', 'yes', '1'] %}
{% set origin = namespace(v4=[], v6=[]) %}
{% for cidr in (cloudflare_ip_ranges | default([])) + (http_origin_lock_extra_cidrs | default([])) %}
{% if ':' in cidr %}{% set origin.v6 = origin.v6 + [cidr] %}{% else %}{% set origin.v4 = origin.v4 + [cidr] %}{% endif %}
{% endfor %}
{% set origin_v4 = origin.v4 %}
{% set origin_v6 = origin.v6 %}
{% if origin_lock and origin_v4 %}
  # Sources allowed to reach the HTTP origin ports (Cloudflare edge +
  # http_origin_lock_extra_cidrs) while the origin lock is on.
  set http_origin_v4 {
    type ipv4_addr
    flags interval
    elements = {
{% for cidr in origin_v4 %}
      {{ cidr }}{% if not loop.last %},{% endif %}
{% endfor %}
    }
  }

{% endif %}
{% if origin_lock and origin_v6 %}
  set http_origin_v6 {
    type ipv6_addr
    flags interval
    elements = {
{% for cidr in origin_v6 %}
      {{ cidr }}{% if not loop.last %},{% endif %}
{% endfor %}
    }
  }

{% endif %}
  # Per-source SSH rate-limit state; bounded and expiring so an
  # internet-wide scan cannot grow it without limit.
  set ssh_ratelimit_v4 {
    type ipv4_addr
    size 65535
    flags dynamic,timeout
    timeout 5m
  }

  # ─── Input chain ───────────────────────────────────────────────
  chain input {
    type filter hook input priority filter; policy drop;

    # Conntrack
    ct state established,related accept
    ct state invalid drop

    # Loopback
    iif lo accept

    # ICMP — ping/traceroute OK, rate-limited
    ip protocol icmp limit rate 10/second accept
    ip6 nexthdr ipv6-icmp limit rate 10/second accept

    # SSH — only from allowed CIDRs, rate-limited PER SOURCE. 30/minute
    # (was 4/minute) leaves room for operator multi-shell sessions; one
    # shared bucket let any single scanner starve every other new SSH
    # connection into `policy drop`. If the set is full the update does
    # not match and the accept below still applies.
{% for rule in public_allow_ports if rule.port == 22 %}
    tcp dport {{ rule.port }} ip saddr @ssh_allowed_v4 ct state new update @ssh_ratelimit_v4 { ip saddr limit rate over 30/minute burst 10 packets } drop comment "{{ rule.comment }}-ratelimit"
    tcp dport {{ rule.port }} ip saddr @ssh_allowed_v4 ct state new accept comment "{{ rule.comment }}"
{% endfor %}

    # Public ports (Caddy, stellar-core SCP peer). With the origin lock on,
    # the HTTP origin ports admit only the Cloudflare edge, internal_cidrs
    # and the extra CIDRs; other sources fall through to policy drop.
{% for rule in public_allow_ports if rule.port != 22 %}
{% if origin_lock and rule.port in (http_origin_lock_ports | default([80, 443])) %}
{% if origin_v4 %}
    {{ rule.proto }} dport {{ rule.port }} ip saddr @http_origin_v4 accept comment "{{ rule.comment }} (origin lock)"
{% endif %}
{% if origin_v6 %}
    {{ rule.proto }} dport {{ rule.port }} ip6 saddr @http_origin_v6 accept comment "{{ rule.comment }} (origin lock)"
{% endif %}
    {{ rule.proto }} dport {{ rule.port }} ip saddr @internal_v4 accept comment "{{ rule.comment }} (internal)"
{% else %}
    {{ rule.proto }} dport {{ rule.port }} accept comment "{{ rule.comment }}"
{% endif %}
{% endfor %}

    # Internal-only services
{% for rule in internal_allow_ports %}
    {{ rule.proto }} dport {{ rule.port }} ip saddr @internal_v4 accept comment "{{ rule.comment }}"
{% endfor %}

    # Log drops at low rate for debugging
    limit rate 5/second log prefix "nft-drop: " level info
  }

  # ─── Forward + output ──────────────────────────────────────────
  chain forward {
    type filter hook forward priority filter; policy drop;
  }

  chain output {
    type filter hook output priority filter; policy accept;
  }
}
