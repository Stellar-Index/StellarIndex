#!/usr/sbin/nft -f
#
# Stellar Index archival-node firewall.
#
# Policy: default-deny on input; SCP peer + SSH open publicly;
# internal-only services restricted to internal_cidrs.

flush ruleset

table inet filter {

  # ─── Sets of trusted CIDRs ─────────────────────────────────────
  set internal_v4 {
    type ipv4_addr
    flags interval
    elements = {
{% for cidr in internal_cidrs if ':' not in cidr %}
      {{ cidr }}{% if not loop.last %},{% endif %}
{% endfor %}
    }
  }

  set ssh_allowed_v4 {
    type ipv4_addr
    flags interval
    elements = {
{% for cidr in allowed_ssh_cidrs if ':' not in cidr %}
      {{ cidr }}{% if not loop.last %},{% endif %}
{% endfor %}
    }
  }

  # Per-source SSH rate-limit state; bounded and expiring so an
  # internet-wide scan cannot grow it without limit.
  set ssh_ratelimit_v4 {
    type ipv4_addr
    size 65535
    flags dynamic,timeout
    timeout 5m
  }

  # ─── Input chain ───────────────────────────────────────────────
  chain input {
    type filter hook input priority filter; policy drop;

    # Conntrack
    ct state established,related accept
    ct state invalid drop

    # Loopback
    iif lo accept

    # ICMP — ping/traceroute OK, rate-limited
    ip protocol icmp limit rate 10/second accept
    ip6 nexthdr ipv6-icmp limit rate 10/second accept

    # SSH — only from allowed CIDRs, rate-limited PER SOURCE. 30/minute
    # (was 4/minute) leaves room for operator multi-shell sessions; one
    # shared bucket let any single scanner starve every other new SSH
    # connection into `policy drop`. If the set is full the update does
    # not match and the accept below still applies.
{% for rule in public_allow_ports if rule.port == 22 %}
    tcp dport {{ rule.port }} ip saddr @ssh_allowed_v4 ct state new update @ssh_ratelimit_v4 { ip saddr limit rate over 30/minute burst 10 packets } drop comment "{{ rule.comment }}-ratelimit"
    tcp dport {{ rule.port }} ip saddr @ssh_allowed_v4 ct state new accept comment "{{ rule.comment }}"
{% endfor %}

    # Public ports (stellar-core SCP peer)
{% for rule in public_allow_ports if rule.port != 22 %}
    {{ rule.proto }} dport {{ rule.port }} accept comment "{{ rule.comment }}"
{% endfor %}

    # Internal-only services
{% for rule in internal_allow_ports %}
    {{ rule.proto }} dport {{ rule.port }} ip saddr @internal_v4 accept comment "{{ rule.comment }}"
{% endfor %}

    # Log drops at low rate for debugging
    limit rate 5/second log prefix "nft-drop: " level info
  }

  # ─── Forward + output ──────────────────────────────────────────
  chain forward {
    type filter hook forward priority filter; policy drop;
  }

  chain output {
    type filter hook output priority filter; policy accept;
  }
}
