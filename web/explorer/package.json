{
  "name": "@stellarindex/explorer",
  "version": "0.0.0",
  "private": true,
  "description": "Public showcase site + explorer for the Stellar Index API (stellarindex.io).",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:api": "openapi-typescript ../../openapi/stellar-index.v1.yaml -o src/api/types.ts",
    "build:worker": "OPEN_NEXT=1 opennextjs-cloudflare build -c wrangler.ssr.jsonc",
    "preview:worker": "opennextjs-cloudflare preview -c wrangler.ssr.jsonc",
    "prebuild": "mkdir -p public/openapi && cp ../../openapi/stellar-index.v1.yaml public/openapi/stellar-index.v1.yaml"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tanstack/react-query": "^5.102.8",
    "clsx": "^2.1.1",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^1.35.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "satori": "^0.33.4",
    "tailwind-merge": "^3.6.0",
    "workers-og": "^0.0.27"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.9.0",
    "eslint-config-next": "16.3.3",
    "jsdom": "^30.0.1",
    "openapi-typescript": "^7.4.4",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "wrangler": "4.127.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "workerd",
      "esbuild",
      "sharp",
      "@resvg/resvg-js",
      "unrs-resolver"
    ],
    "overrides": {
      "brace-expansion": ">=5.0.9",
      "postcss@<8.5.10": ">=8.5.10",
      "js-yaml": ">=4.3.1 <5",
      "sharp@<0.35.0": ">=0.35.0",
      "nanoid@<4": ">=3.3.17",
      "nanoid@>=4": ">=5.1.6",
      "undici@>=7 <8": ">=7.29.0",
      "undici@>=8": ">=8.9.0"
    },
    "patchedDependencies": {
      "eslint-plugin-react@7.37.5": "patches/eslint-plugin-react@7.37.5.patch"
    }
  }
}
