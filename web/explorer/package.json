{
  "name": "@stellarindex/explorer",
  "version": "0.0.0",
  "private": true,
  "description": "Public showcase site + explorer for the Stellar Index API (stellarindex.io).",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:api": "openapi-typescript ../../openapi/stellar-index.v1.yaml -o src/api/types.ts",
    "build:worker": "OPEN_NEXT=1 opennextjs-cloudflare build -c wrangler.ssr.jsonc",
    "preview:worker": "opennextjs-cloudflare preview -c wrangler.ssr.jsonc",
    "prebuild": "mkdir -p public/openapi && cp ../../openapi/stellar-index.v1.yaml public/openapi/stellar-index.v1.yaml",
    "postbuild": "pnpm run postbuild:pages && pnpm run postbuild:prune && pnpm run postbuild:budget && pnpm run postbuild:seo && pnpm run postbuild:shell-fallback",
    "postbuild:pages": "HEADING_ORDER_REQUIRE_BUILD=1 NAV_SHELL_REQUIRE_BUILD=1 vitest run --reporter=verbose src/lib/heading-order.built.test.ts src/lib/nav-shell.built.test.ts",
    "postbuild:prune": "find out -type f -name '__next.*' ! -name '__next._tree.txt' -delete",
    "postbuild:budget": "bash ../../scripts/ci/explorer-file-budget.sh out",
    "postbuild:seo": "bash ../../scripts/ci/explorer-seo-lint.sh out",
    "postbuild:shell-fallback": "bash ../../scripts/ci/explorer-shell-fallback-check.sh out functions"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.103.2",
    "clsx": "^2.1.1",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0",
    "workers-og": "^0.0.27"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.6",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.11.0",
    "eslint-config-next": "16.3.5",
    "jsdom": "^30.1.0",
    "openapi-typescript": "^7.4.4",
    "postcss": "^8.5.28",
    "prettier": "^3.9.8",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1",
    "wrangler": "4.136.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "workerd",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "brace-expansion": ">=5.0.9",
      "postcss@<8.5.10": ">=8.5.10",
      "js-yaml": ">=4.3.1 <5",
      "sharp@<0.35.0": ">=0.35.0",
      "nanoid@<4": ">=3.3.17",
      "nanoid@>=4": ">=5.1.6",
      "undici@>=7 <8": ">=7.29.0",
      "undici@>=8": ">=8.9.0"
    },
    "patchedDependencies": {
      "eslint-plugin-react@7.37.5": "patches/eslint-plugin-react@7.37.5.patch"
    }
  }
}
