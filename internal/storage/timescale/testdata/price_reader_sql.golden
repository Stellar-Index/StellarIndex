-- closedVWAP1mAtOrBefore (set)
SELECT k.ord, x.* FROM unnest($1::text[], $2::text[]) WITH ORDINALITY AS k(base, quote, ord)
CROSS JOIN LATERAL (
        SELECT * FROM (
            (SELECT bucket, base_asset, vwap::text, COALESCE(volume_priced, 0)::text,
                    COALESCE(trade_count, 0), sources
               FROM prices_1m
              WHERE base_asset = k.base AND quote_asset = k.quote AND vwap IS NOT NULL
                AND bucket <= $3::timestamptz - INTERVAL '1 minute'
              ORDER BY bucket DESC
              LIMIT 2)
            UNION ALL
            (SELECT bucket, base_asset, vwap::text, COALESCE(volume_priced, 0)::text,
                    COALESCE(trade_count, 0), sources
               FROM prices_1m
              WHERE base_asset = k.quote AND quote_asset = k.base AND vwap IS NOT NULL
                AND bucket <= $3::timestamptz - INTERVAL '1 minute'
              ORDER BY bucket DESC
              LIMIT 2)
        ) AS both_directions
         ORDER BY bucket DESC, base_asset
         LIMIT 2
    ) AS x(bucket, base_asset, vwap, volume_priced, trade_count, sources)
