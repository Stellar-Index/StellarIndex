# Copy to `.env` in this directory. docker-compose picks it up
# automatically. Never commit .env (it's in .gitignore).
#
# The defaults here are the same ones wired into dev.yaml. Override
# if another service on your machine is already on these ports.

# ─── Postgres + TimescaleDB ────────────────────────────────────────
TIMESCALE_IMAGE_TAG=2.26.4-pg15
POSTGRES_DB=stellarindex
POSTGRES_USER=stellarindex
POSTGRES_PASSWORD=stellarindex-dev
POSTGRES_PORT=5432

# ─── Redis ─────────────────────────────────────────────────────────
REDIS_IMAGE_TAG=7.4-alpine
REDIS_PORT=6379
REDIS_MAXMEM=512mb

# ─── MinIO ─────────────────────────────────────────────────────────
# minio/minio + minio/mc are gone from Docker Hub/quay.io; both binaries
# now come from one cgr.dev/chainguard/minio image (INV-0706/INV-0265).
MINIO_IMAGE_TAG=latest
MINIO_IMAGE_DIGEST=6a1d0b45c8669726bba580ced0bfa4cb9fdeed1ed636dfabd81d1577beb6937b
MINIO_ROOT_USER=stellarindex
MINIO_ROOT_PASSWORD=stellarindex-dev-minio
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
