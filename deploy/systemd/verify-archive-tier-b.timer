# systemd timer: nightly verify-archive Tier B (checkpoint anchor).
#
# Per docs/operations/archival-node-bringup.md §"Per-region trust +
# verification model" — R1 (the integrity leader per ADR-0016) runs the
# Tier B checkpoint anchor nightly, alongside the Tier A chain check. R2 +
# R3 don't run this timer (they delegate to R1).
#
# Schedule: 04:37 UTC + up to 10 min of jitter. Picked to:
#   - Sit AFTER the Tier A chain run (03:23 UTC) so the two heavy LCM walks
#     don't contend for host I/O, and so Tier B never races Tier A for the
#     shared incremental state file (they also share the run-heavy-job.sh
#     singleton lock in the ansible variant, which enforces this).
#   - Sit BEFORE the European morning operator window so a fresh failure is
#     investigable on first-coffee.
#   - Off-minute (:37) avoids cron-aligned thundering herd against S3 /
#     the archive mirror.
#
# Persistent=true: if the box was off at 04:37, fire on next boot — a
# planned reboot doesn't skip a night's anchor check.

[Unit]
Description=Nightly verify-archive Tier B (checkpoint anchor)
Documentation=https://github.com/Stellar-Index/StellarIndex/blob/main/docs/operations/archival-node-bringup.md

[Timer]
OnCalendar=*-*-* 04:37:00 UTC
RandomizedDelaySec=600
Persistent=true
Unit=verify-archive-tier-b.service

[Install]
WantedBy=timers.target
