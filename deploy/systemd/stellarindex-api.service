# systemd unit: stellarindex-api (public REST + SSE server).
#
# Long-running daemon. Serves /v1/* endpoints by reading the
# aggregator's Redis cache + Timescale fallback. The L3.* surface
# work shipped earlier in Wk 7.
#
# Operator wiring (after aggregator is running):
#
#   sudo cp deploy/systemd/stellarindex-api.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now stellarindex-api.service
#
# Configuration:
#   /etc/stellarindex.toml — [api] section + [api.sep10] when auth
#                            is wired
#   /etc/default/stellarindex-api — the API's secrets, plus
#                                  STELLARINDEX_SEP10_SEED + JWT secret
#                                  env vars when SEP-10 is configured
#
# Its own uid does not cover the Postgres, ClickHouse and Redis credentials it
# holds: they stay as strong as the daemons' until the host sets least-privilege ones.
#
# Ordering only (After=, no Requires=), as the deployed templates: a
# Requires= on a unit the host does not have (Postgres in a container
# or managed) refuses to start, and a datastore stop leaves this unit
# stopped, not failed, so nothing restarts it or alerts. Postgres is
# pinged once at boot and a failure exits the process, so the restart
# limit below, not the binary, is what rides out a Postgres restart.
# Dependencies:
#   - postgresql.service — fallback path when Redis is empty
#   - redis-server.service — primary read path for VWAP +
#     confidence
#   - clickhouse-server.service — a no-op when the lake is remote
#     or absent.
#
# Notes:
#   - The api binary listens on cfg.API.ListenAddr (default
#     0.0.0.0:3000). Behind a reverse proxy in production; the L4.3
#     HAProxy role handles TLS termination + per-key rate-limit
#     forwarding.
#   - `Type=simple` rather than `Type=notify` because the binary
#     doesn't currently emit `sd_notify(READY=1)`. A follow-up
#     could add that for tighter readiness signalling; for now
#     the /v1/readyz endpoint is the readiness probe.

[Unit]
Description=Stellar Index — public API (REST + SSE)
Documentation=https://github.com/Stellar-Index/StellarIndex/blob/main/docs/reference/api/index.html
After=network-online.target postgresql.service redis-server.service clickhouse-server.service
Wants=network-online.target

# Restart-storm limit — [Unit] directives per systemd.unit(5). systemd
# >=230 (the Ubuntu 22.04/24.04 deploy targets) IGNORES StartLimit* if
# placed under [Service]. When more than StartLimitBurst restarts occur
# within StartLimitIntervalSec the unit enters `failed`, which the
# node_systemd_unit_state{state="failed"} alert pages on.
# RestartSteps/RestartMaxDelaySec below back restarts off to 2 min, which keeps
# even an hours-long Postgres outage under this burst, so the unit recovers on
# its own instead of parking; stellarindex_api_down covers it while it is down.
StartLimitIntervalSec=15min
StartLimitBurst=100

[Service]
Type=simple
# Its own uid, never the ingest daemons': create it with
#   useradd --system --user-group --no-create-home --home-dir /nonexistent \
#     --shell /usr/sbin/nologin stellarindex-api
User=stellarindex-api
Group=stellarindex-api
WorkingDirectory=/
# The API's only env file, 0640 root:stellarindex-api, holding just the names it
# reads (STELLARINDEX_POSTGRES_DSN — the stellarindex_api role's, migration 0213 —
# Redis, ClickHouse serving/live, dashboard and forex keys). Required: a missing
# file is a misconfiguration, not a default.
EnvironmentFile=/etc/default/stellarindex-api
# The ops-batch ClickHouse identity (docs/operations/clickhouse-ops-batch-profile.md)
# would demote every connection this binary opens without explicit credentials;
# systemd applies UnsetEnvironment= after every EnvironmentFile=, so it cannot reach
# the API whatever the file holds (TestOpsBatchIdentityNeverReachesLiveDaemons).
UnsetEnvironment=STELLARINDEX_CLICKHOUSE_OPS_USER STELLARINDEX_CLICKHOUSE_OPS_PASSWORD

ExecStart=/usr/local/bin/stellarindex-api -config /etc/stellarindex.toml

LimitNOFILE=1048576
LimitNPROC=1048576

# API restart policy is the strictest of the three — if it crashes
# end users see 502s until restart. Keep the cooldown short. The
# restart-storm limit that trips the unit into `failed` lives in
# [Unit] (StartLimit*).
Restart=on-failure
RestartSec=5s
RestartSteps=10
RestartMaxDelaySec=2min

# Same ceiling as the role's template: bounds a leak on a shared host.
MemoryHigh=4G
MemoryMax=8G

# Hardening, kept in step with the role's stellarindex-api.service.j2. Its own uid
# plus ProtectProc=invisible keep sibling daemons' /proc entries out of reach.
# ProcSubset=pid is not set: it hides /proc/sys/net/core/somaxconn, cutting Go's
# listen backlog to 128.
ProtectProc=invisible
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
InaccessiblePaths=-/run/lock -/etc/default/stellarindex -/etc/default/galexie -/etc/default/galexie-backfill -/etc/default/stellarindex-ops -/etc/clickhouse-client
# Caps the wabt children it runs on uploaded WASM; EPERM, not SIGSYS, on a miss.
TasksMax=4096
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# Bind to a privileged port (80/443) only via reverse proxy. For
# direct binding on 3000 (the default) no AmbientCapabilities are
# needed.

[Install]
WantedBy=multi-user.target
