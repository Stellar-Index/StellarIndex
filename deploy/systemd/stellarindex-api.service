# systemd unit: stellarindex-api (public REST + SSE server).
#
# Long-running daemon. Serves /v1/* endpoints by reading the
# aggregator's Redis cache + Timescale fallback. The L3.* surface
# work shipped earlier in Wk 7.
#
# Operator wiring (after aggregator is running):
#
#   sudo cp deploy/systemd/stellarindex-api.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now stellarindex-api.service
#
# Configuration:
#   /etc/stellarindex.toml — [api] section + [api.sep10] when auth
#                            is wired
#   /etc/default/stellarindex-ops — STELLARINDEX_SEP10_SEED + JWT
#                                  secret env vars when SEP-10 is
#                                  configured
#
# Dependencies (must be running BEFORE the api starts):
#   - postgresql.service — fallback path when Redis is empty
#   - redis-server.service — primary read path for VWAP +
#     confidence
#
# Notes:
#   - The api binary listens on cfg.API.ListenAddr (default
#     0.0.0.0:3000). Behind a reverse proxy in production; the L4.3
#     HAProxy role handles TLS termination + per-key rate-limit
#     forwarding.
#   - `Type=simple` rather than `Type=notify` because the binary
#     doesn't currently emit `sd_notify(READY=1)`. A follow-up
#     could add that for tighter readiness signalling; for now
#     the /v1/readyz endpoint is the readiness probe.

[Unit]
Description=Stellar Index — public API (REST + SSE)
Documentation=https://github.com/Stellar-Index/StellarIndex/blob/main/docs/reference/api/index.html
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target
Requires=postgresql.service redis-server.service

# Restart-storm limit — [Unit] directives per systemd.unit(5). systemd
# >=230 (the Ubuntu 22.04/24.04 deploy targets) IGNORES StartLimit* if
# placed under [Service]. When more than StartLimitBurst restarts occur
# within StartLimitIntervalSec the unit enters `failed`, which the
# node_systemd_unit_state{state="failed"} alert pages on.
StartLimitIntervalSec=5min
StartLimitBurst=10

[Service]
Type=simple
User=stellarindex
Group=stellarindex
WorkingDirectory=/var/lib/stellarindex
# The ops-batch ClickHouse identity must never reach this daemon. This
# reference unit sources the SAME env file the interactive and
# timer-driven stellarindex-ops jobs source, and
# docs/operations/clickhouse-ops-batch-profile.md prescribes writing
# STELLARINDEX_CLICKHOUSE_OPS_USER/_PASSWORD (the low-priority
# `ops_batch` identity) into exactly that file. Those two vars demote
# every ClickHouse connection this binary opens
# (internal/storage/clickhouse/ops_auth.go) to the batch tier — today
# this binary opens its explorer/supply readers with ADR-0048 D4's
# explicit `api_serving` credentials and so reaches none of them, but
# one future no-credential reader here would inherit the pair from the
# shared file — i.e. the exact inverse of the 2026-08-28 r1 incident
# the profile exists to prevent. A comment can only ask;
# UnsetEnvironment= enforces it: systemd applies it AFTER every
# Environment=/EnvironmentFile=, so the pair cannot reach this daemon
# whatever the operator puts in the file (needs systemd >= 235 — the
# Ubuntu 22.04/24.04 deploy targets ship 249/255, and an older systemd
# ignores an unknown key with a warning rather than failing the unit).
# The batch one-shots that share the file (verify-archive-tier-*,
# ch-live-catchup) deliberately do NOT strip it — that is where the
# identity belongs. Both halves are pinned by
# TestOpsBatchIdentityNeverReachesLiveDaemons
# (internal/storage/clickhouse/ops_auth_systemd_test.go).
EnvironmentFile=-/etc/default/stellarindex-ops
UnsetEnvironment=STELLARINDEX_CLICKHOUSE_OPS_USER STELLARINDEX_CLICKHOUSE_OPS_PASSWORD

ExecStart=/usr/local/bin/stellarindex-api -config /etc/stellarindex.toml
ExecStop=/bin/kill -TERM $MAINPID

LimitNOFILE=1048576
LimitNPROC=1048576

# API restart policy is the strictest of the three — if it crashes
# end users see 502s until restart. Keep the cooldown short. The
# restart-storm limit that trips the unit into `failed` lives in
# [Unit] (StartLimit*).
Restart=on-failure
RestartSec=5s

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=/var/lib/stellarindex

# Bind to a privileged port (80/443) only via reverse proxy. For
# direct binding on 3000 (the default) no AmbientCapabilities are
# needed.

[Install]
WantedBy=multi-user.target
