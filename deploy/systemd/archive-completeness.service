# systemd unit: archive-completeness verify daemon.
#
# Per ADR-0017 §"Daily completeness cron". Runs once on each timer
# tick (one-shot oneshot semantics); the timer file at
# archive-completeness.timer schedules the cadence.
#
# REFERENCE unit for self-hosters. The reference deployment (r1) runs
# the ansible-rendered
# configs/ansible/roles/archival-node/templates/systemd/archive-completeness.service.j2
# instead; that template is the authority, and this file mirrors its
# ARCHIVE_TO mechanism. Keep the two in step.
#
# Operator wiring — BOTH files, the helper first:
#
#   sudo install -m 0755 \
#     configs/ansible/roles/archival-node/files/compute-archive-to.sh \
#     /usr/local/sbin/compute-archive-to.sh
#   sudo cp deploy/systemd/archive-completeness.{service,timer} /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now archive-completeness.timer
#
# Configuration (override via /etc/default/archive-completeness):
#
#   ARCHIVE_FROM       Default 2 (genesis). Set it to your hot floor if
#                      you trim history (ADR-0027): below the floor the
#                      local archive is deliberately empty.
#   ARCHIVE_TO         Network head ledger. **REQUIRED and non-zero** —
#                      `archive-completeness verify` refuses to run
#                      without it ("-to is required",
#                      internal/ops/archive/archive_completeness.go).
#                      There is deliberately no Environment= default
#                      here: ExecStartPre computes it at start time from
#                      the indexer cursor and writes
#                      /run/archive-completeness.env, which the
#                      EnvironmentFile below layers on top. Set it in
#                      /etc/default/archive-completeness only if you are
#                      not running the helper.
#   STELLAR_NETWORK    pubnet (default) | testnet | futurenet. The
#                      cross-anchor FILL phase is PUBNET-ONLY; on any
#                      other value it REFUSES rather than write pubnet
#                      checkpoints into a test-net store.
#   TEXTFILE_OUTPUT    node_exporter's textfile_collector dir + filename
#   REPORT_OUTPUT      JSON report path (operator audit trail)

[Unit]
Description=Stellar Index — archive-completeness verify (daily cron per ADR-0017)
Documentation=https://github.com/Stellar-Index/StellarIndex/blob/main/docs/operations/archive-completeness.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=-/etc/default/archive-completeness
# ARCHIVE_TO is computed at start time from the indexer cursor —
# compute-archive-to.sh writes ARCHIVE_TO=<n> here. This file is loaded
# LAST so it wins over /etc/default/archive-completeness.
EnvironmentFile=-/run/archive-completeness.env

# Sensible defaults. Operators override via /etc/default/archive-completeness.
# NOTE: there is no ARCHIVE_TO default on purpose. It used to be
# `Environment=ARCHIVE_TO=0`, which the binary rejects outright ("-to is
# required") — so a self-hoster who followed the wiring above got a unit
# that failed on every single timer tick.
Environment=ARCHIVE_FROM=2
Environment=STELLAR_NETWORK=pubnet
Environment=TEXTFILE_OUTPUT=/var/lib/node_exporter/textfile_collector/archive_completeness.prom
Environment=REPORT_OUTPUT=/var/lib/galexie/last-completeness-report.json
Environment=WORKERS=8

ExecStartPre=/usr/local/sbin/compute-archive-to.sh
ExecStart=/usr/local/bin/stellarindex-ops archive-completeness verify \
  -from ${ARCHIVE_FROM} \
  -to ${ARCHIVE_TO} \
  -workers ${WORKERS} \
  -network ${STELLAR_NETWORK} \
  -textfile-output ${TEXTFILE_OUTPUT} \
  -output-file ${REPORT_OUTPUT}

# Run as root because we need to chown placed files to stellar:stellar
# (see ADR-0017 §"Per-region behaviour" — R1 leader). On R2/R3
# without local cross-anchor archive this whole timer is disabled
# (the regions delegate to R1 via metric scrape).
User=root

# Hardening — read-only most of the filesystem, write only where we
# need to: archive root, the textfile output dir, the report dir.
ProtectSystem=full
PrivateTmp=true
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=/srv/history-archive /var/lib/galexie /var/lib/node_exporter

# A clean run is fast; a worst-case (lots of fallback chain
# fetches) shouldn't exceed 30 min. Hard-cap so a hung HTTP source
# can't wedge the timer.
TimeoutStartSec=30min

[Install]
WantedBy=multi-user.target
