[Unit]
Description=Stellar Index config-assertion check (guard configs live?)

[Service]
Type=oneshot
ExecStart=/usr/local/bin/config-assertions.sh

# Runs as root: this probe reads root-only secrets (/etc/default/galexie)
# and runs privileged host checks — `nft list ruleset`, `zpool status`,
# `apt-mark showhold` — that a dropped user cannot perform. ProtectSystem
# is `full` (not `strict`) to keep /var and /root writable: the probe
# writes its node_exporter textfile-collector output under /var and mc
# uses HOME=/root. Hardening mirrors the archive-completeness root oneshot.
User=root
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true
ProtectKernelTunables=true
# ProtectKernelModules is deliberately NOT set: it makes /lib/modules
# INACCESSIBLE, which silently killed the zfs_module_on_disk assertion
# (the 2026-07-03 guard against an apt downgrade deleting the dkms
# module and leaving the pool one reboot from unimportable) — it read
# FAIL on every run from the moment the unit went live, 2026-07-27, and
# no reformulation helps: `ls`, `modinfo`, and `dkms status` all consult
# that tree. This script never loads or unloads a module, so the flag
# bought nothing here while disabling a load-bearing integrity check.
ProtectControlGroups=true
ReadWritePaths=/var/lib/node_exporter/textfile_collector

# Hourly probe of a handful of host commands (nft/zpool/apt-mark); a
# normal run is seconds. Bound a hang (e.g. a wedged `zpool status`)
# so it fails and frees the next hourly tick instead of leaving the
# config-assertion textfile gauge silently stuck.
TimeoutStartSec=5min
RuntimeMaxSec=5min
