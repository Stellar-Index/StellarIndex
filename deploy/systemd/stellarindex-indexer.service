# systemd unit: stellarindex-indexer (Galexie → dispatcher → decoder
# pipeline that produces canonical.Trade rows in TimescaleDB).
#
# Long-running daemon. Reads ledger meta from MinIO via the
# go-stellar-sdk's ApplyLedgerMetadata path, dispatches each event
# to its decoder per `internal/dispatcher/`, and inserts the
# resulting canonical.Trade rows. See
# `docs/architecture/ingest-pipeline.md` for the full picture.
#
# Operator wiring:
#
#   sudo cp deploy/systemd/stellarindex-indexer.service /etc/systemd/system/
#   sudo cp /etc/default/stellarindex-ops.example /etc/default/stellarindex-ops  # AWS creds
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now stellarindex-indexer.service
#
# Configuration:
#   /etc/stellarindex.toml — global config (region, sources, storage)
#   /etc/default/stellarindex-ops — AWS_ACCESS_KEY_ID + secret for MinIO read
#
# Dependencies (must be running BEFORE the indexer starts):
#   - minio.service (the source of ledger meta)
#   - postgresql.service (the trade-row destination)
#   - The `stellarindex` DB must exist + be migrated
#     (`stellarindex-migrate up`)
#
# Restart policy: on-failure with a 10s delay. A panic during a
# decoder bug should bring the binary back so a single bad ledger
# doesn't wedge the pipeline indefinitely; an actually-broken
# config (DB unreachable) loops, and what makes that VISIBLE is
# `stellarindex_ingestion_ledger_stalled` (page) — the committed
# ledger cursor stops advancing. (There is no
# `stellarindex_indexer_health` metric; nothing has ever emitted one,
# and this comment named it until 2026-09-03.)

[Unit]
Description=Stellar Index — indexer (decoder pipeline → canonical trades)
Documentation=https://github.com/Stellar-Index/StellarIndex/blob/main/docs/architecture/ingest-pipeline.md
After=network-online.target minio.service postgresql.service redis-server.service
Wants=network-online.target
Requires=postgresql.service

# Restart-storm limit — [Unit] directives per systemd.unit(5). systemd
# >=230 (the Ubuntu 22.04/24.04 deploy targets) IGNORES StartLimit* if
# placed under [Service]. When more than StartLimitBurst restarts occur
# within StartLimitIntervalSec the unit enters `failed`, which
# `stellarindex_systemd_unit_failed` alerts on — at severity TICKET,
# for: 15m (configs/prometheus/rules.r1/infra.yml), not a page.
#
# Sized as a DEPENDENCY-OUTAGE budget, not a magic number (#371 F3).
# With RestartSec=10s below, 60 restarts is ~10 minutes of continuous
# failure before the unit parks — comfortably longer than a MinIO or
# Postgres restart (2-3 min observed on r1, including a config apply),
# and the interval must exceed 60 × 10s = 600s or the burst could never
# accumulate inside the window and the unit would hot-loop forever
# instead of parking. Was 10/5min, i.e. ~100 SECONDS: an indexer that
# exits on a dependency blip was parked in `failed` before the
# dependency finished restarting, needing a human `systemctl
# reset-failed` to bring ingest back.
#
# What this does NOT do, so nobody plans around it: a permanently broken
# config (bad credentials, deleted bucket) will not park the unit either.
# With the retry budget in force the process survives ~5 min per attempt
# and RestartSec adds 10s, so a start cycle is ~5min10s — it can never
# reach 60 starts inside a 15-minute window, and `systemd_unit_failed`
# therefore never fires for that fault.
#
# That ~5min10s figure holds only because the budget covers the datastore
# OPEN as well as the walk (internal/ledgerstream `retryLiveStart`). The
# open + schema load run BEFORE the SDK fetch worker that spends the
# in-walk budget exists, so until that outer retry landed a lake outage
# present at START failed in about a second, the cycle collapsed to
# RestartSec, sixty starts DID fit inside 15 minutes, and the unit parked
# in `failed` — staying parked after MinIO came back until a human ran
# `systemctl reset-failed`. Delete that retry and this paragraph becomes
# false again; TestStream_liveTail_retriesWhenDataStoreIsDownAtStart is
# what keeps it honest.
#
# The cover is `stellarindex_ingestion_ledger_stalled` (page, ~10 min,
# docs/operations/runbooks/ledger-ingest-stalled.md): the committed
# LEDGER cursor stops advancing. It is deliberately not
# `all_sources_stopped`, which this comment named until 2026-09-03 and
# which cannot cover a lake outage on this deployment — the CEX/FX
# connectors run in the same binary and keep
# stellarindex_source_events_total moving while no ledger is read at
# all. `cursor_stuck` cannot cover it either: it joins `on (source)
# stellarindex_source_enabled`, and "ledgerstream" is a cursor
# namespace rather than a configured source.
StartLimitIntervalSec=15min
StartLimitBurst=60

[Service]
Type=simple
User=stellarindex
Group=stellarindex
WorkingDirectory=/var/lib/stellarindex
# The ops-batch ClickHouse identity must never reach this daemon. This
# reference unit sources the SAME env file the interactive and
# timer-driven stellarindex-ops jobs source, and
# docs/operations/clickhouse-ops-batch-profile.md prescribes writing
# STELLARINDEX_CLICKHOUSE_OPS_USER/_PASSWORD (the low-priority
# `ops_batch` identity) into exactly that file. Those two vars demote
# every ClickHouse connection this binary opens
# (internal/storage/clickhouse/ops_auth.go) to the batch tier — here
# the LIVE ledger sink (clickhouse.NewLiveSink -> Open) every ledger is
# written through, plus the signer-tagger's lake reader — i.e. the
# exact inverse of the 2026-08-28 r1 incident the profile exists to
# prevent. A comment can only ask; UnsetEnvironment= enforces it:
# systemd applies it AFTER every Environment=/EnvironmentFile=, so the
# pair cannot reach this daemon whatever the operator puts in the file
# (needs systemd >= 235 — the Ubuntu 22.04/24.04 deploy targets ship
# 249/255, and an older systemd ignores an unknown key with a warning
# rather than failing the unit). The batch one-shots that share the
# file (verify-archive-tier-*, ch-live-catchup) deliberately do NOT
# strip it — that is where the identity belongs. Both halves are pinned
# by TestOpsBatchIdentityNeverReachesLiveDaemons
# (internal/storage/clickhouse/ops_auth_systemd_test.go).
EnvironmentFile=-/etc/default/stellarindex-ops
UnsetEnvironment=STELLARINDEX_CLICKHOUSE_OPS_USER STELLARINDEX_CLICKHOUSE_OPS_PASSWORD

ExecStart=/usr/local/bin/stellarindex-indexer -config /etc/stellarindex.toml
ExecStop=/bin/kill -TERM $MAINPID

# File-descriptor limits matter — each enabled source can hold
# several network connections + DB pool + MinIO read sockets.
LimitNOFILE=1048576
LimitNPROC=1048576

# Restart on crash but with backoff to avoid hot-looping on a
# config-side break (e.g. DB unreachable). 10s matches
# stellarindex-aggregator; the API uses 5s because it is customer-
# facing. The restart-storm limit that marks the unit `failed` (which
# `stellarindex_systemd_unit_failed` TICKETS on after 15m — it is not a
# page) lives in [Unit] (StartLimit*) — see the comment there, which
# derives its burst FROM this value.
Restart=on-failure
RestartSec=10s

# Hardening — read-only most of the filesystem, write only to
# the working dir + the cache dir if any.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=/var/lib/stellarindex

[Install]
WantedBy=multi-user.target
